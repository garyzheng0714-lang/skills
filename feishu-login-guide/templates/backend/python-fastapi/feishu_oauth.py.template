"""
飞书登录处理（FBIF + 富的 双企业 App，FastAPI）

占位符：
  {{FBIF_APP_ID}}   → FBIF 主企业飞书 App ID（cli_xxx），从密钥仓库读
  {{FUDE_APP_ID}}   → 富的 App ID，从密钥仓库读

所有 App ID / Secret 都从密钥仓库（~/Library/Mobile Documents/com~apple~CloudDocs/
密钥/FBIF登录应用APPid和密钥/feishu-app-credentials.md）取，绝不在代码里 fallback。

使用：
  from fastapi import FastAPI
  from app.middleware.feishu_oauth import feishu_router
  app = FastAPI()
  app.include_router(feishu_router)

环境变量（全部必填，缺则启动时报错）：
  FEISHU_FBIF_APP_SECRET   FBIF App Secret
  FEISHU_FUDE_APP_SECRET   富的 App Secret
  FEISHU_REDIRECT_BASE     部署 URL，不带路径（绝对不能是 http://localhost:...）
  FEISHU_ALLOWED_TENANT_KEYS  选填，逗号分隔白名单

路由：
  GET  /auth/feishu/fbif/login        FBIF 按钮模式
  GET  /auth/feishu/fbif/callback     FBIF 按钮回调（v2 token）
  GET  /auth/feishu/fbif/qr-config    FBIF 扫码配置
  GET  /auth/feishu/fbif/qr-callback  FBIF 扫码回调（v1 token）
  GET  /auth/feishu/fude/...          富的 4 条同上
  POST /auth/feishu/logout            退出登录（共享）
"""

import os
import secrets
from typing import Literal, Optional
from urllib.parse import urlencode

import httpx
from fastapi import APIRouter, HTTPException, Request, Response
from fastapi.responses import JSONResponse, RedirectResponse
from pydantic import BaseModel

# ========== 双 App 配置 ==========

FBIF_APP_ID = "{{FBIF_APP_ID}}"

# 富的文化传媒（上海）有限公司 App（v3 起跨项目共享）
FUDE_APP_ID = "{{FUDE_APP_ID}}"

# 按钮模式：v2 OAuth (accounts.feishu.cn)
AUTHORIZE_URL = "https://accounts.feishu.cn/open-apis/authen/v1/authorize"
TOKEN_V2_URL = "https://open.feishu.cn/open-apis/authen/v2/oauth/token"

# 扫码模式：v1 OAuth (passport.feishu.cn)
QR_AUTHORIZE_URL = "https://passport.feishu.cn/suite/passport/oauth/authorize"
APP_TOKEN_URL = "https://open.feishu.cn/open-apis/auth/v3/app_access_token/internal"
TOKEN_V1_URL = "https://open.feishu.cn/open-apis/authen/v1/access_token"

USER_INFO_URL = "https://open.feishu.cn/open-apis/authen/v1/user_info"

STATE_TTL = 600  # 10 分钟

Tenant = Literal["fbif", "fude"]
ALL_TENANTS: list[Tenant] = ["fbif", "fude"]

_TENANT_CONFIG: dict[Tenant, dict[str, str]] = {
    "fbif": {
        "app_id": FBIF_APP_ID,
        "secret_env": "FEISHU_FBIF_APP_SECRET",
    },
    "fude": {
        "app_id": FUDE_APP_ID,
        "secret_env": "FEISHU_FUDE_APP_SECRET",
    },
}


def _app_id(t: Tenant) -> str:
    return _TENANT_CONFIG[t]["app_id"]


def _tenant_secret(t: Tenant) -> str:
    env_name = _TENANT_CONFIG[t]["secret_env"]
    v = os.getenv(env_name)
    if not v:
        # 不允许任何 fallback：缺 env 立刻失败，定位清楚
        raise RuntimeError(
            f"{env_name} not set. Read it from the credentials vault: "
            f"~/Library/Mobile Documents/com~apple~CloudDocs/密钥/FBIF登录应用APPid和密钥/"
        )
    return v


def _redirect_base() -> str:
    return os.getenv("FEISHU_REDIRECT_BASE", "http://localhost:8080").rstrip("/")


def _callback_uri(t: Tenant) -> str:
    return f"{_redirect_base()}/auth/feishu/{t}/callback"


def _qr_callback_uri(t: Tenant) -> str:
    return f"{_redirect_base()}/auth/feishu/{t}/qr-callback"


def _state_cookie_name(t: Tenant, mode: str) -> str:
    return f"feishu_state_{t}_{mode}"


# ========== 类型 ==========


class FeishuUser(BaseModel):
    open_id: str
    union_id: str
    user_id: Optional[str] = None
    name: str
    en_name: Optional[str] = None
    avatar_url: str
    email: Optional[str] = None
    mobile: Optional[str] = None
    tenant_key: str


feishu_router = APIRouter(prefix="/auth/feishu")


# ========== 按钮模式 ==========


@feishu_router.get("/{tenant}/login")
async def login(tenant: Tenant, request: Request):
    _validate_tenant(tenant)
    state = secrets.token_urlsafe(24)
    params = {
        "client_id": _app_id(tenant),
        "redirect_uri": _callback_uri(tenant),
        "response_type": "code",
        "state": state,
    }
    response = RedirectResponse(url=f"{AUTHORIZE_URL}?{urlencode(params)}")
    set_state_cookie(request, response, _state_cookie_name(tenant, "oauth"), state)
    return response


@feishu_router.get("/{tenant}/callback")
async def callback(
    tenant: Tenant,
    request: Request,
    code: Optional[str] = None,
    state: Optional[str] = None,
    error: Optional[str] = None,
    error_description: Optional[str] = None,
):
    _validate_tenant(tenant)
    cookie_name = _state_cookie_name(tenant, "oauth")
    if not verify_state_cookie(request, cookie_name, state):
        raise HTTPException(status_code=403, detail="state mismatch")
    if error:
        print(f"feishu authorize denied ({tenant}): {error} - {error_description}")
        return _redirect_clear("/login?error=denied", cookie_name)
    if not code:
        raise HTTPException(status_code=400, detail="missing code")
    try:
        token = await exchange_code_v2(tenant, code)
        return await finish_login(tenant, token, cookie_name)
    except Exception as e:
        print(f"feishu callback failed ({tenant}): {e}")
        raise HTTPException(status_code=500, detail="login failed")


# ========== 扫码模式 ==========


@feishu_router.get("/{tenant}/qr-config")
async def qr_config(tenant: Tenant, request: Request):
    _validate_tenant(tenant)
    state = secrets.token_urlsafe(24)
    params = {
        "client_id": _app_id(tenant),
        "redirect_uri": _qr_callback_uri(tenant),
        "response_type": "code",
        "state": state,
    }
    response = JSONResponse(
        content={
            "goto": f"{QR_AUTHORIZE_URL}?{urlencode(params)}",
            "state": state,
            "expires_in": 300,
        },
        headers={"Cache-Control": "no-store"},
    )
    set_state_cookie(request, response, _state_cookie_name(tenant, "qr"), state)
    return response


@feishu_router.get("/{tenant}/qr-callback")
async def qr_callback(
    tenant: Tenant,
    request: Request,
    code: Optional[str] = None,
    state: Optional[str] = None,
    error: Optional[str] = None,
    error_description: Optional[str] = None,
):
    _validate_tenant(tenant)
    cookie_name = _state_cookie_name(tenant, "qr")
    if not verify_state_cookie(request, cookie_name, state):
        raise HTTPException(status_code=403, detail="state mismatch")
    if error:
        print(f"feishu QR authorize denied ({tenant}): {error} - {error_description}")
        return _redirect_clear("/login?error=denied", cookie_name)
    if not code:
        raise HTTPException(status_code=400, detail="missing code")
    try:
        app_token = await get_app_access_token(tenant)
        user_token = await exchange_code_v1(code, app_token)
        return await finish_login(tenant, user_token, cookie_name)
    except Exception as e:
        print(f"feishu QR callback failed ({tenant}): {e}")
        raise HTTPException(status_code=500, detail="login failed")


# ========== Logout（共享） ==========


@feishu_router.post("/logout")
async def logout(response: Response):
    # TODO: 调用项目现有 session 清理逻辑
    response.status_code = 204
    return response


# ========== 共用 ==========


def _validate_tenant(t: str) -> None:
    if t not in ALL_TENANTS:
        raise HTTPException(status_code=404, detail=f"unknown tenant: {t}")


async def finish_login(tenant: Tenant, user_token: str, state_cookie_name: str):
    user = await fetch_user_info(user_token)
    print(
        f"[auth] login ok via {tenant} tenant_key={user.tenant_key} "
        f"open_id={user.open_id} name={user.name}"
    )
    if not is_allowed_tenant(user.tenant_key):
        print(f"login denied: tenant_key {user.tenant_key!r} not allowed")
        return _redirect_clear("/login?error=unauthorized_tenant", state_cookie_name)
    local_id = await upsert_local_user(user)
    response = RedirectResponse(url="/")
    response.delete_cookie(state_cookie_name, path="/auth/feishu")
    create_session(response, local_id)
    return response


def _redirect_clear(url: str, cookie_name: str) -> RedirectResponse:
    resp = RedirectResponse(url=url)
    resp.delete_cookie(cookie_name, path="/auth/feishu")
    return resp


# ========== Token 兑换 ==========


async def exchange_code_v2(tenant: Tenant, code: str) -> str:
    secret = _tenant_secret(tenant)
    async with httpx.AsyncClient(timeout=10.0) as client:
        resp = await client.post(
            TOKEN_V2_URL,
            json={
                "grant_type": "authorization_code",
                "client_id": _app_id(tenant),
                "client_secret": secret,
                "code": code,
                "redirect_uri": _callback_uri(tenant),
            },
            headers={"Content-Type": "application/json; charset=utf-8"},
        )
    data = resp.json()
    if data.get("code") != 0 or not data.get("access_token"):
        raise RuntimeError(
            f"v2 token api code={data.get('code')} desc={data.get('error_description')}"
        )
    return data["access_token"]


async def get_app_access_token(tenant: Tenant) -> str:
    secret = _tenant_secret(tenant)
    async with httpx.AsyncClient(timeout=10.0) as client:
        resp = await client.post(
            APP_TOKEN_URL,
            json={"app_id": _app_id(tenant), "app_secret": secret},
            headers={"Content-Type": "application/json; charset=utf-8"},
        )
    data = resp.json()
    if data.get("code") != 0 or not data.get("app_access_token"):
        raise RuntimeError(f"app_token api code={data.get('code')} msg={data.get('msg')}")
    return data["app_access_token"]


async def exchange_code_v1(code: str, app_access_token: str) -> str:
    async with httpx.AsyncClient(timeout=10.0) as client:
        resp = await client.post(
            TOKEN_V1_URL,
            json={"grant_type": "authorization_code", "code": code},
            headers={
                "Content-Type": "application/json; charset=utf-8",
                "Authorization": f"Bearer {app_access_token}",
            },
        )
    data = resp.json()
    inner = (data or {}).get("data") or {}
    if data.get("code") != 0 or not inner.get("access_token"):
        raise RuntimeError(f"v1 token api code={data.get('code')} msg={data.get('msg')}")
    return inner["access_token"]


async def fetch_user_info(token: str) -> FeishuUser:
    async with httpx.AsyncClient(timeout=10.0) as client:
        resp = await client.get(
            USER_INFO_URL,
            headers={"Authorization": f"Bearer {token}"},
        )
    data = resp.json()
    if data.get("code") != 0:
        raise RuntimeError(f"user_info api code={data.get('code')} msg={data.get('msg')}")
    return FeishuUser(**data["data"])


# ========== 工具 ==========


def set_state_cookie(request: Request, response: Response, name: str, value: str) -> None:
    response.set_cookie(
        key=name,
        value=value,
        max_age=STATE_TTL,
        httponly=True,
        secure=request.url.scheme == "https",
        samesite="lax",
        path="/auth/feishu",
    )


def verify_state_cookie(request: Request, name: str, query_state: Optional[str]) -> bool:
    cookie = request.cookies.get(name)
    return bool(cookie) and cookie == query_state


def is_allowed_tenant(tenant_key: str) -> bool:
    allowed = os.getenv("FEISHU_ALLOWED_TENANT_KEYS", "")
    if not allowed:
        return True
    return tenant_key in {k.strip() for k in allowed.split(",")}


