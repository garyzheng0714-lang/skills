// 北京时间（中国不用夏令时，固定 +8，不依赖服务器装没装时区库）。
var chinaTime = time.FixedZone("CST", 8*3600)

// Identity 是集成平台给的身份。认人用 Key()，不要用邮箱：富的账号邮箱为空。
// 账号密码登录的人 CompanyCode 是 "account"，Sub 是账号表里那一行的 record_id（改账号名还是同一个人），Name 是账号。
type Identity struct {
	CompanyCode string `json:"company_code"`
	Sub         string `json:"sub"`
	Name        string `json:"name"`
	Email       string `json:"email,omitempty"`
	Picture     string `json:"picture,omitempty"`
}

func (i Identity) Key() string { return i.CompanyCode + ":" + i.Sub }

// User 是已登录请求里的当前用户，用 CurrentUser(r) 取。Features 是这个人能用的功能（Feature.Key）。
type User struct {
	ID string
	Identity
	Features []string
}

// Feature 是项目里按人开关的功能，在代码里声明。Column 是账号表里对应复选框列的列名，一字不差。
// 飞书登录的人有全部功能；账号密码登录的人只有那一行勾上的。列不存在或不是复选框，这个功能对所有人关掉。
type Feature struct {
	Key    string
	Column string
}

type Session struct {
	IDHash      string    `json:"id_hash"`
	UserID      string    `json:"user_id"`
	Identity    Identity  `json:"identity"`
	RefreshSeal string    `json:"refresh_seal"`
	CreatedAt   time.Time `json:"created_at"`
	CheckedAt   time.Time `json:"checked_at"`
	LastSeenAt  time.Time `json:"last_seen_at"`
	Version     int64     `json:"version"`
	// Account 为 true 是账号密码登录的会话：没有 refresh_token，不找集成平台核对，也不归停用名单管。
	Account bool `json:"account,omitempty"`
	// AccountCredential 是登录时密码的指纹（不是密码本身），表里改了密码对不上，会话就下线。
	AccountCredential string `json:"account_credential,omitempty"`
	// Features 是账号会话那一行勾上的功能，每个核对周期按表更新；飞书会话不用它。
	Features []string `json:"features,omitempty"`
}

type BlockEntry struct {
	Reason string `json:"reason"`
	Since  string `json:"since,omitempty"`
}

type Blocklist struct {
	Revision int64                 `json:"revision"`
	SyncedAt time.Time             `json:"synced_at"`
	Entries  map[string]BlockEntry `json:"entries"`
}

var (
	ErrConflict       = errors.New("sso: session changed or gone")
	ErrStaleBlocklist = errors.New("sso: blocklist older than the stored one")
	ErrNotAllowed     = errors.New("sso: user not allowed in this project")
)

// Store 是会话和停用名单的存储。多实例部署必须用所有实例共享的库实现它，
// 踢人和拒绝登录才能所有实例一起生效。
type Store interface {
	CreateSession(ctx context.Context, s Session) error
	// GetSession 找不到返回 nil, nil。
	GetSession(ctx context.Context, idHash string) (*Session, error)
	// UpdateSession 只在库里版本仍等于 expectVersion 时写入，并把版本加一；
	// 会话已删除或已被别处改过返回 ErrConflict。
	UpdateSession(ctx context.Context, s Session, expectVersion int64) error
	// DeleteSession 返回被删的会话，不存在返回 nil, nil。
	DeleteSession(ctx context.Context, idHash string) (*Session, error)
	// DeleteSessionsBySub 删掉这些 sub 的全部会话并返回它们；账号密码会话（Account=true）不归名单管，不删。
	DeleteSessionsBySub(ctx context.Context, subs map[string]BlockEntry) ([]Session, error)
	// AccountSessions 返回全部账号密码会话（Account=true；sub 是账号表那一行的 record_id），对账号表用。
	AccountSessions(ctx context.Context) ([]Session, error)
	// BlocklistRevision 返回库里名单的版本；synced=false 表示从没成功同步过。
	BlocklistRevision(ctx context.Context) (revision int64, synced bool, err error)
	// BlockedEntry 查一个 sub 在不在名单里，不在返回 nil, nil。
	BlockedEntry(ctx context.Context, sub string) (*BlockEntry, error)
	// SaveBlocklist 整份替换名单，但只在 b.Revision 不小于库里版本时写入，否则返回 ErrStaleBlocklist。
	// 比较和写入必须是一个原子操作：多实例时晚到的旧名单不能盖掉新名单。
	SaveBlocklist(ctx context.Context, b Blocklist) error
}

type Options struct {
	Store Store
	// OnLogin 把身份对上本项目的用户（按 Identity.Key() 查找或新建），返回本项目用户 ID。
	// 返回 ErrNotAllowed 表示本项目不让这个人进。账号密码登录同样经过它，company_code 是 "account"。
	OnLogin func(ctx context.Context, id Identity) (userID string, err error)
	// Features 是本项目按人开关的功能，可选；接口里用 HasFeature(r, key) 判断。
	Features []Feature
}

type SSO struct {
	oauth          oauth2.Config
	verifier       *oidc.IDTokenVerifier
	userInfoURL    string
	revokeURL      string
	blocklistURL   string
	aead           cipher.AEAD
	checkEvery     time.Duration
	reconcileEvery time.Duration
	syncMinGap     time.Duration
	store          Store
	onLogin        func(context.Context, Identity) (string, error)
	features       []Feature
	projectRec     string // 总账本「系统」表里本项目那一行的 record_id，写进日志「项目」
	logMaxRows     int
	credKey        []byte // 算密码指纹用，从 SSO_TOKEN_KEY 派生
	compareKey     []byte // 比较密码用，每个进程随机一把

	// 账号表、日志表都没配时 feishu、outbox 为 nil：账号密码登录一律 401，不记日志。
	feishu        *bitable
	accountsTable *tableRef
	logTable      *tableRef
	outbox        *outbox

	locks      sync.Map // idHash → *sync.Mutex
	retryAfter sync.Map // idHash → time.Time，集成平台或账号表故障时别每个请求都去查
	usedStates sync.Map // state → 过期时间，同一个回调并发到达时只换一次码
	syncWake   chan struct{}

	failMu sync.Mutex
	fails  map[string]*accountFails // 账号 → 连错次数；shortcut: 只在本实例内计数

	changedMu    sync.Mutex
	changing     map[string]bool // record_id → 还要不要再处理一遍（正在处理时又来了提醒）
	changedTimes []time.Time     // 最近一分钟处理过的提醒

	healthMu       sync.Mutex
	issues         map[string]map[string]string // "accounts"/"log" → 表结构问题代码 → 说明
	accountsFailed bool                         // 最近一次读账号表失败了
}

type accountFails struct {
	n     int
	first time.Time
}

// New 读环境变量：SSO_ISSUER、SSO_CLIENT_ID、SSO_CLIENT_SECRET、SSO_REDIRECT_URL、
// SSO_BLOCKLIST_URL、SSO_TOKEN_KEY；可选 SSO_ACCOUNTS_TABLE、SSO_LOG_TABLE（多维表格链接）及配了表就必填的
// SSO_FEISHU_APP_ID、SSO_FEISHU_APP_SECRET、SSO_OUTBOX_FILE，配了日志表就必填的 SSO_LOG_PROJECT_RECORD，
// 可选 SSO_LOG_MAX_ROWS（默认 45000）、SSO_RECONCILE_INTERVAL（兜底对账间隔，默认 6h，10m～24h）；
// SSO_FEISHU_API、SSO_CHECK_INTERVAL、SSO_SYNC_MIN_GAP 只给合规测试用，生产留空。
// 事件优先：账号表靠登录、用户的请求和账号表变更提醒，名单靠名单提醒，日志有东西进来就写；
// 进程里另有一个兜底对账循环（reconcileLoop），启动先跑一轮，之后每 SSO_RECONCILE_INTERVAL 一轮。
func New(ctx context.Context, opt Options) (*SSO, error) {
	if opt.Store == nil || opt.OnLogin == nil {
		return nil, errors.New("sso: Store and OnLogin are required")
	}
	if err := validateFeatures(opt.Features); err != nil {
		return nil, err
	}
	env := map[string]string{}
	var missing []string
	for _, k := range []string{"SSO_ISSUER", "SSO_CLIENT_ID", "SSO_CLIENT_SECRET", "SSO_REDIRECT_URL", "SSO_BLOCKLIST_URL", "SSO_TOKEN_KEY"} {
		env[k] = strings.TrimSpace(os.Getenv(k))
		if env[k] == "" {
			missing = append(missing, k)
		}
	}
	if len(missing) > 0 {
		return nil, fmt.Errorf("sso: missing env %s", strings.Join(missing, ", "))
	}
	redirect, err := url.Parse(env["SSO_REDIRECT_URL"])
	if err != nil || redirect.Path != callbackPath {
		return nil, fmt.Errorf("sso: SSO_REDIRECT_URL must end with %s", callbackPath)
	}
	key, err := base64.StdEncoding.DecodeString(env["SSO_TOKEN_KEY"])
	if err != nil || len(key) != 32 {
		return nil, errors.New("sso: SSO_TOKEN_KEY must be 32 random bytes in base64 (openssl rand -base64 32)")
	}
	block, _ := aes.NewCipher(key)
	aead, _ := cipher.NewGCM(block)

	checkEvery, err := envDuration("SSO_CHECK_INTERVAL", defaultCheck)
	if err != nil {
		return nil, err
	}
	reconcileEvery, err := envDuration("SSO_RECONCILE_INTERVAL", defaultReconcile)
	if err != nil {
		return nil, err
	}
	// 每轮整表读一次账号表、拉一次名单（集成平台按运行次数计费）。短于 10 分钟只给合规测试（连的是假飞书）用。
	if reconcileEvery < minReconcile && strings.TrimSpace(os.Getenv("SSO_FEISHU_API")) == "" {
		return nil, fmt.Errorf("sso: SSO_RECONCILE_INTERVAL %s is too short, at least %s", reconcileEvery, minReconcile)
	}
	if reconcileEvery > maxReconcile {
		return nil, fmt.Errorf("sso: SSO_RECONCILE_INTERVAL %s is too long, at most %s", reconcileEvery, maxReconcile)
	}
	// 每次拉名单都算集成平台一次工作流运行（按月计费）：伪造的提醒再多，一个实例每 30 秒最多拉一次。
	syncMinGap, err := envDuration("SSO_SYNC_MIN_GAP", defaultGap)
	if err != nil {
		return nil, err
	}
	accountsTable, err := envTable("SSO_ACCOUNTS_TABLE")
	if err != nil {
		return nil, err
	}
	logTable, err := envTable("SSO_LOG_TABLE")
	if err != nil {
		return nil, err
	}
	logMaxRows := defaultLogMaxRows
	if v := strings.TrimSpace(os.Getenv("SSO_LOG_MAX_ROWS")); v != "" {
		if logMaxRows, err = strconv.Atoi(v); err != nil || logMaxRows < 100 {
			return nil, fmt.Errorf("sso: bad SSO_LOG_MAX_ROWS %q (a row count, at least 100)", v)
		}
	}
	projectRec := strings.TrimSpace(os.Getenv("SSO_LOG_PROJECT_RECORD"))
	if logTable != nil && !recordIDFormat.MatchString(projectRec) {
		return nil, errors.New("sso: SSO_LOG_TABLE set but SSO_LOG_PROJECT_RECORD missing or not a record id (rec…): the row id of this project in the 总账本「系统」table")
	}
	var feishu *bitable
	var ob *outbox
	if accountsTable != nil || logTable != nil {
		missing = nil
		for _, k := range []string{"SSO_FEISHU_APP_ID", "SSO_FEISHU_APP_SECRET", "SSO_OUTBOX_FILE"} {
			env[k] = strings.TrimSpace(os.Getenv(k))
			if env[k] == "" {
				missing = append(missing, k)
			}
		}
		if len(missing) > 0 {
			return nil, fmt.Errorf("sso: SSO_ACCOUNTS_TABLE/SSO_LOG_TABLE set but missing env %s", strings.Join(missing, ", "))
		}
		api := strings.TrimRight(strings.TrimSpace(os.Getenv("SSO_FEISHU_API")), "/")
		if api == "" {
			api = defaultFeishuAPI
		}
		feishu = &bitable{api: api, appID: env["SSO_FEISHU_APP_ID"], appSecret: env["SSO_FEISHU_APP_SECRET"]}
		var targets []string
		if accountsTable != nil {
			targets = append(targets, targetAccounts)
		}
		if logTable != nil {
			targets = append(targets, targetLog)
		}
		if ob, err = openOutbox(env["SSO_OUTBOX_FILE"], targets); err != nil {
			return nil, err
		}
	}

	provider, err := oidc.NewProvider(ctx, env["SSO_ISSUER"])
	if err != nil {
		return nil, fmt.Errorf("sso: discovery: %w", err)
	}
	var meta struct {
		Revocation string `json:"revocation_endpoint"`
	}
	if err := provider.Claims(&meta); err != nil || meta.Revocation == "" || provider.UserInfoEndpoint() == "" {
		return nil, errors.New("sso: discovery lacks userinfo or revocation endpoint")
	}
	endpoint := provider.Endpoint()
	endpoint.AuthStyle = oauth2.AuthStyleInHeader

	s := &SSO{
		oauth: oauth2.Config{
			ClientID:     env["SSO_CLIENT_ID"],
			ClientSecret: env["SSO_CLIENT_SECRET"],
			RedirectURL:  env["SSO_REDIRECT_URL"],
			Endpoint:     endpoint,
			Scopes:       []string{oidc.ScopeOpenID, "profile", "email", oidc.ScopeOfflineAccess},
		},
		// 集成平台也声明了 HS256，只认 RS256，避免拿 client secret 伪造签名。
		verifier:       provider.Verifier(&oidc.Config{ClientID: env["SSO_CLIENT_ID"], SupportedSigningAlgs: []string{oidc.RS256}}),
		userInfoURL:    provider.UserInfoEndpoint(),
		revokeURL:      meta.Revocation,
		blocklistURL:   env["SSO_BLOCKLIST_URL"],
		aead:           aead,
		checkEvery:     checkEvery,
		reconcileEvery: reconcileEvery,
		syncMinGap:     syncMinGap,
		store:          opt.Store,
		onLogin:        opt.OnLogin,
		features:       opt.Features,
		projectRec:     projectRec,
		logMaxRows:     logMaxRows,
		changing:       map[string]bool{},
		credKey:        hmacSum(key, "sso-account-credential"),
		compareKey:     []byte(randToken()),
		feishu:         feishu,
		accountsTable:  accountsTable,
		logTable:       logTable,
		outbox:         ob,
		syncWake:       make(chan struct{}, 1),
		fails:          map[string]*accountFails{},
		issues:         map[string]map[string]string{},
	}
	go s.syncLoop()
	if ob != nil {
		go ob.saveLoop()
		for _, target := range ob.targets() {
			go s.outboxWorker(target)
		}
	}
	go s.reconcileLoop()
	return s, nil
}

func validateFeatures(features []Feature) error {
	keys, cols := map[string]bool{}, map[string]bool{}
	for _, c := range accountColumns {
		cols[c.name] = true
	}
	for _, f := range features {
		if f.Key == "" || f.Column == "" || keys[f.Key] || cols[f.Column] {
			return fmt.Errorf("sso: Features: key and column must be non-empty and unique, column not one of the system columns: %+v", f)
		}
		keys[f.Key], cols[f.Column] = true, true
	}
	return nil
}

// Register 挂飞书登录、回调、账号密码登录、退出、/api/me、名单提醒、账号表变更提醒、健康检查八条路由。
// 要记请求日志，再用 Middleware 包住整个 mux。
func (s *SSO) Register(mux *http.ServeMux) {
	mux.HandleFunc("GET "+loginPath, s.handleLogin)
	mux.HandleFunc("POST "+accountPath, s.handleAccountLogin)
	mux.HandleFunc("GET "+callbackPath, s.handleCallback)
	mux.HandleFunc("POST "+logoutPath, s.handleLogout)
	mux.Handle("GET "+mePath, s.RequireUser(http.HandlerFunc(s.handleMe)))
	mux.HandleFunc("POST "+blocklistPath, s.handleBlocklistChanged)
	mux.HandleFunc("POST "+accountsChangedPath, s.handleAccountsChanged)
	mux.HandleFunc("GET "+healthPath, s.handleHealth)
}

// RequireUser 包住所有要登录的接口，包括下载、导出、长连接。没登录回 401。
func (s *SSO) RequireUser(next http.Handler) http.Handler { return s.require(next, false) }

// RequireFreshUser 给 HR、盖章、改权限、敏感导出：每次当场找集成平台核对，核对不了就拒绝；账号密码会话一律 403。
func (s *SSO) RequireFreshUser(next http.Handler) http.Handler { return s.require(next, true) }

type userKey struct{}

func CurrentUser(r *http.Request) *User {
	u, _ := r.Context().Value(userKey{}).(*User)
	return u
}

// HasFeature 判断当前用户能不能用某个功能（Options.Features 里的 Key），只在 RequireUser 包住的接口里有意义。
func HasFeature(r *http.Request, key string) bool {
	u := CurrentUser(r)
	return u != nil && slices.Contains(u.Features, key)
}

// ---------- 登录 ----------

type loginTxn struct {
	State    string `json:"state"`
	Nonce    string `json:"nonce"`
	Verifier string `json:"verifier"`
	Next     string `json:"next"`
	Expires  int64  `json:"expires"`
}

func (s *SSO) handleLogin(w http.ResponseWriter, r *http.Request) {
	t := loginTxn{
		State:    randToken(),
		Nonce:    randToken(),
		Verifier: oauth2.GenerateVerifier(),
		Next:     safeNext(r.URL.Query().Get("next")),
		Expires:  time.Now().Add(txnTTL).Unix(),
	}
	raw, _ := json.Marshal(t)
	// 登录事务加密放在发起登录的浏览器里：回调换了浏览器就对不上，防止把别人登进自己的账号。
	setCookie(w, txnCookieName(t.State), s.seal("login-txn", raw), txnTTL)
	http.Redirect(w, r, s.oauth.AuthCodeURL(t.State, oidc.Nonce(t.Nonce), oauth2.S256ChallengeOption(t.Verifier)), http.StatusFound)
}

func (s *SSO) handleCallback(w http.ResponseWriter, r *http.Request) {
	q := r.URL.Query()
	ev := requestEvent(r, methodFeishu)
	fail := func(code, reason string, why string, args ...any) {
		log.Printf("sso: login failed (%s): "+why, append([]any{code}, args...)...)
		ev.Event, ev.Reason = eventLoginFail, reason
		s.record(ev)
		http.Redirect(w, r, "/login?error="+code, http.StatusFound)
	}
	state := q.Get("state")
	if len(state) < 16 {
		fail("expired", "回调没带 state", "no state")
		return
	}
	c, cookieErr := r.Cookie(txnCookieName(state))
	setCookie(w, txnCookieName(state), "", -1)
	if e := q.Get("error"); e != "" {
		fail("denied", "集成平台返回错误："+cleanCode(e), "idp error %s", cleanCode(e))
		return
	}
	var t loginTxn
	if cookieErr != nil {
		fail("expired", "登录事务不在这个浏览器里", "no login txn cookie")
		return
	}
	raw, err := s.open("login-txn", c.Value)
	if err != nil || json.Unmarshal(raw, &t) != nil || t.State != state || time.Now().Unix() > t.Expires {
		fail("expired", "登录事务对不上或已过期", "login txn invalid")
		return
	}
	ev.Next = t.Next
	// shortcut: 只防同一实例内的并发回调；多实例要防，就把登录事务放进共享库原子消费。
	if !s.consumeState(state, t.Expires) {
		fail("expired", "登录事务已用过", "login txn already used")
		return
	}

	ctx, cancel := context.WithTimeout(r.Context(), upstreamLimit)
	defer cancel()
	// 授权码只换一次，失败也不重试：集成平台见到重放会把第一次发的令牌一并作废。
	tok, err := s.oauth.Exchange(ctx, q.Get("code"), oauth2.VerifierOption(t.Verifier))
	if err != nil {
		fail("failed", "换令牌失败", "exchange: %s", oauthErr(err))
		return
	}
	id, code, reason, err := s.verifyLogin(ctx, tok, t.Nonce)
	ev = withIdentity(ev, id)
	if err != nil {
		s.revoke(ctx, tok.RefreshToken)
		fail(code, reason, "%v", err)
		return
	}
	ev.Permissions = s.permissionColumns(s.allFeatures())
	if why, blocked := s.blocked(ctx, id.Sub); blocked {
		s.revoke(ctx, tok.RefreshToken)
		fail("disabled", "停用名单："+why, "sub %s refused: %s", id.Sub, why)
		return
	}
	userID, err := s.onLogin(ctx, id)
	if err != nil {
		s.revoke(ctx, tok.RefreshToken)
		if errors.Is(err, ErrNotAllowed) {
			fail("unauthorized_tenant", "本项目不让进", "project refused %s", id.Key())
		} else {
			fail("failed", "OnLogin 出错", "OnLogin: %v", err)
		}
		return
	}

	sid := randToken()
	now := time.Now()
	sess := Session{IDHash: hashID(sid), UserID: userID, Identity: id, RefreshSeal: s.seal("refresh-token", []byte(tok.RefreshToken)), CreatedAt: now, CheckedAt: now, LastSeenAt: now, Version: 1}
	if err := s.store.CreateSession(ctx, sess); err != nil {
		s.revoke(ctx, tok.RefreshToken)
		fail("failed", "建会话失败", "create session: %v", err)
		return
	}
	ev.Session = sessionTag(sess.IDHash)
	// 名单同步先落名单再扫会话；这里先建会话再查一次名单，两边交错时不会漏掉人。
	if why, blocked := s.blocked(ctx, id.Sub); blocked {
		s.endSession(ctx, sess.IDHash)
		fail("disabled", "停用名单："+why, "sub %s blocked during login", id.Sub)
		return
	}
	setCookie(w, sessionCookie, sid, sessionIdle+touchEvery)
	log.Printf("sso: login %s user=%s", id.Key(), userID)
	ev.Event = eventLoginOK
	s.record(ev)
	next := t.Next
	if next == "" {
		next = "/"
	}
	http.Redirect(w, r, next, http.StatusFound)
}

// verifyLogin 返回身份；失败时给回调错误码和写进日志的原因。
func (s *SSO) verifyLogin(ctx context.Context, tok *oauth2.Token, nonce string) (Identity, string, string, error) {
	rawID, _ := tok.Extra("id_token").(string)
	idt, err := s.verifier.Verify(ctx, rawID)
	if err != nil {
		return Identity{}, "failed", "ID 令牌无效", fmt.Errorf("id_token: %w", err)
	}
	if idt.Nonce != nonce {
		return Identity{}, "failed", "ID 令牌的 nonce 对不上", errors.New("id_token nonce mismatch")
	}
	var claims Identity
	if err := idt.Claims(&claims); err != nil || claims.Sub == "" {
		return Identity{}, "failed", "ID 令牌没有 sub", errors.New("id_token without sub")
	}
	// 下面几种失败把 claims 一并返回，日志里能看出是谁被拒。
	if !allowedCompanyCodes[claims.CompanyCode] {
		return claims, "unauthorized_tenant", "不是 FBIF 或富的：" + cleanCode(claims.CompanyCode), fmt.Errorf("company_code %q not allowed", claims.CompanyCode)
	}
	if tok.RefreshToken == "" {
		return claims, "failed", "没拿到 refresh_token", errors.New("no refresh_token (offline_access not granted)")
	}
	info, err := s.userInfo(ctx, tok.AccessToken, claims.Sub)
	if errors.Is(err, errDenied) {
		return claims, "denied", "集成平台禁止访问", err
	}
	if err != nil {
		return claims, "failed", "查用户信息失败", err
	}
	if claims.Name == "" {
		claims.Name = info.Name
	}
	if claims.Email == "" {
		claims.Email = info.Email
	}
	if claims.Picture == "" {
		claims.Picture = info.Picture
	}
	return claims, "", "", nil
}

// ---------- 会话 ----------

var (
	errRejected    = errors.New("sso: session rejected")
	errUnavailable = errors.New("sso: idp unavailable")
	errStore       = errors.New("sso: store unavailable")
	errDenied      = errors.New("sso: idp denied this user")
	errTokenStale  = errors.New("sso: access token superseded")
)

func (s *SSO) require(next http.Handler, fresh bool) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		note := noteOf(r)
		if note != nil && fresh {
			note.mu.Lock()
			note.fresh = true
			note.mu.Unlock()
		}
		sess, status := s.authenticate(r.Context(), r, fresh)
		if sess == nil {
			if status == http.StatusUnauthorized {
				setCookie(w, sessionCookie, "", -1)
				writeJSON(w, status, map[string]any{"error": "login_required", "login_url": loginPath})
			} else if status == http.StatusForbidden {
				writeJSON(w, status, map[string]any{"error": "sso_required"})
			} else {
				writeJSON(w, status, map[string]any{"error": "login_service_unavailable"})
			}
			return
		}
		if time.Since(sess.LastSeenAt) >= touchEvery {
			touched := *sess
			touched.LastSeenAt = time.Now()
			if s.store.UpdateSession(r.Context(), touched, sess.Version) == nil {
				if c, err := r.Cookie(sessionCookie); err == nil {
					setCookie(w, sessionCookie, c.Value, sessionIdle+touchEvery)
				}
			}
		}
		if note != nil {
			note.mu.Lock()
			note.sess = sess
			note.mu.Unlock()
		}
		ctx := context.WithValue(r.Context(), userKey{}, &User{ID: sess.UserID, Identity: sess.Identity, Features: s.featuresOf(sess)})
		next.ServeHTTP(w, r.WithContext(ctx))
	})
}

func (s *SSO) authenticate(ctx context.Context, r *http.Request, fresh bool) (*Session, int) {
	c, err := r.Cookie(sessionCookie)
	if err != nil || c.Value == "" {
		return nil, http.StatusUnauthorized
	}
	sess, err := s.store.GetSession(ctx, hashID(c.Value))
	if err != nil {
		log.Printf("sso: load session: %v", err)
		return nil, http.StatusServiceUnavailable
	}
	if sess == nil {
		return nil, http.StatusUnauthorized
	}
	// 滑动续期的时间每小时才写一次，多留一小时，保证 30 天没用才过期。
	if time.Since(sess.LastSeenAt) > sessionIdle+touchEvery {
		s.endSession(ctx, sess.IDHash)
		return nil, http.StatusUnauthorized
	}
	if sess.Account {
		// 敏感接口只认集成平台身份：账号密码没法当场找集成平台核对。
		if fresh {
			return nil, http.StatusForbidden
		}
		if time.Since(sess.CheckedAt) < s.checkEvery {
			return sess, http.StatusOK
		}
		return s.checkAccount(ctx, r, sess)
	}
	// 每个请求都查名单：名单落库后、踢人前进程挂了，旧会话也进不来。
	if e, err := s.store.BlockedEntry(ctx, sess.Identity.Sub); err != nil {
		log.Printf("sso: load blocklist: %v", err)
		return nil, http.StatusServiceUnavailable
	} else if e != nil {
		s.revokeSession(ctx, r, sess.IDHash, "停用名单："+e.Reason)
		return nil, http.StatusUnauthorized
	}
	if !fresh && time.Since(sess.CheckedAt) < s.checkEvery {
		return sess, http.StatusOK
	}
	inGrace := !fresh && time.Since(sess.CheckedAt) < s.checkEvery+outageGrace
	if until, ok := s.retryAfter.Load(sess.IDHash); ok && !fresh && time.Now().Before(until.(time.Time)) {
		if inGrace {
			return sess, http.StatusOK
		}
		return nil, http.StatusServiceUnavailable
	}
	cctx, cancel := context.WithTimeout(ctx, upstreamLimit)
	defer cancel()
	checked, err := s.check(cctx, r, sess.IDHash, fresh)
	switch {
	case err == nil:
		s.retryAfter.Delete(sess.IDHash)
		return checked, http.StatusOK
	case errors.Is(err, errUnavailable):
		s.retryAfter.Store(sess.IDHash, time.Now().Add(outageBackoff))
		if !inGrace {
			return nil, http.StatusServiceUnavailable
		}
		// 核对期间可能已被踢：放行前以库里为准。
		again, gerr := s.store.GetSession(ctx, sess.IDHash)
		if gerr != nil {
			return nil, http.StatusServiceUnavailable
		}
		if again == nil {
			return nil, http.StatusUnauthorized
		}
		return again, http.StatusOK
	case errors.Is(err, errStore):
		return nil, http.StatusServiceUnavailable
	default:
		return nil, http.StatusUnauthorized
	}
}

// check 用 refresh_token 换新的 access_token，再调用户信息：集成平台的「禁止访问」拦在用户信息接口，
// 刷新本身照样成功，所以只看刷新成不成功没有用。
func (s *SSO) check(ctx context.Context, r *http.Request, idHash string, fresh bool) (*Session, error) {
	mu, _ := s.locks.LoadOrStore(idHash, &sync.Mutex{})
	mu.(*sync.Mutex).Lock()
	defer mu.(*sync.Mutex).Unlock()

	cur, err := s.store.GetSession(ctx, idHash)
	if err != nil {
		return nil, errStore
	}
	if cur == nil {
		return nil, errRejected
	}
	if !fresh && time.Since(cur.CheckedAt) < s.checkEvery {
		return cur, nil
	}
	rt, err := s.open("refresh-token", cur.RefreshSeal)
	if err != nil {
		s.revokeSession(ctx, r, idHash, "会话里的令牌解不开")
		return nil, errRejected
	}
	nt, err := s.oauth.TokenSource(ctx, &oauth2.Token{RefreshToken: string(rt), Expiry: time.Now().Add(-time.Minute)}).Token()
	if err != nil {
		if definiteRejection(err) {
			log.Printf("sso: refresh rejected for %s: %s", cur.Identity.Key(), oauthErr(err))
			if gone, _ := s.store.DeleteSession(ctx, idHash); gone != nil {
				s.recordRevoked(r, gone, "集成平台拒绝刷新")
			}
			s.locks.Delete(idHash)
			return nil, errRejected
		}
		log.Printf("sso: refresh unavailable: %s", oauthErr(err))
		return nil, errUnavailable
	}
	newRT := nt.RefreshToken
	if newRT == "" {
		newRT = string(rt)
	}
	next := *cur
	next.RefreshSeal = s.seal("refresh-token", []byte(newRT))

	_, uiErr := s.userInfo(ctx, nt.AccessToken, cur.Identity.Sub)
	if errors.Is(uiErr, errDenied) {
		log.Printf("sso: %s denied by idp, ending session", cur.Identity.Key())
		if gone, _ := s.store.DeleteSession(ctx, idHash); gone != nil {
			s.recordRevoked(r, gone, "集成平台禁止访问")
		}
		s.locks.Delete(idHash)
		s.revoke(ctx, newRT)
		return nil, errRejected
	}
	if uiErr != nil {
		saveErr := s.store.UpdateSession(ctx, next, cur.Version)
		// 401 多半是别的实例同时刷新、把这个 access_token 顶掉了（刷新后旧的立即 401）：以库里为准，不踢人。
		if errors.Is(uiErr, errTokenStale) && errors.Is(saveErr, ErrConflict) {
			if again, gerr := s.store.GetSession(ctx, idHash); gerr == nil && again != nil {
				return again, nil
			}
		}
		log.Printf("sso: userinfo unavailable: %v", uiErr)
		return nil, errUnavailable
	}
	next.CheckedAt = time.Now()
	if err := s.store.UpdateSession(ctx, next, cur.Version); err != nil {
		// 这段时间里会话被踢了（或别的实例刚核对过）：以库里为准，晚到的刷新结果不能把会话救回来。
		again, gerr := s.store.GetSession(ctx, idHash)
		if gerr != nil {
			return nil, errStore
		}
		if again == nil {
			s.revoke(ctx, newRT)
			return nil, errRejected
		}
		return again, nil
	}
	next.Version = cur.Version + 1
	return &next, nil
}

func (s *SSO) handleMe(w http.ResponseWriter, r *http.Request) {
	u := CurrentUser(r)
	writeJSON(w, http.StatusOK, map[string]any{"id": u.ID, "name": u.Name, "avatar_url": u.Picture, "company_code": u.CompanyCode, "features": u.Features})
}

// handleLogout 只退出这个项目在这个浏览器里的会话；飞书和其他项目不受影响。
func (s *SSO) handleLogout(w http.ResponseWriter, r *http.Request) {
	if c, err := r.Cookie(sessionCookie); err == nil && c.Value != "" {
		ctx, cancel := context.WithTimeout(r.Context(), upstreamLimit)
		gone, err := s.endSession(ctx, hashID(c.Value))
		cancel()
		if err != nil {
			log.Printf("sso: logout: %v", err)
			writeJSON(w, http.StatusServiceUnavailable, map[string]any{"error": "logout_failed"})
			return
		}
		if gone != nil {
			s.record(s.sessionEvent(requestEvent(r, ""), gone, eventLogout, ""))
		}
	}
	setCookie(w, sessionCookie, "", -1)
	writeJSON(w, http.StatusOK, map[string]any{"ok": true})
}

// shortcut: 撤销失败只记日志不重试（令牌只在服务端，会话已删）；要做到必撤，就把加密的令牌连同删除一起写进待撤销表。
func (s *SSO) endSession(ctx context.Context, idHash string) (*Session, error) {
	sess, err := s.store.DeleteSession(ctx, idHash)
	if err != nil {
		return nil, err
	}
	s.locks.Delete(idHash)
	s.retryAfter.Delete(idHash)
	if sess != nil && !sess.Account {
		if rt, err := s.open("refresh-token", sess.RefreshSeal); err == nil {
			s.revoke(ctx, string(rt))
		}
	}
	return sess, nil
}

// revokeSession 下线并记一条「被收回」；会话已经不在（别的请求先踢了）就不记。
func (s *SSO) revokeSession(ctx context.Context, r *http.Request, idHash, reason string) {
	if gone, _ := s.endSession(ctx, idHash); gone != nil {
		s.recordRevoked(r, gone, reason)
	}
}

func (s *SSO) recordRevoked(r *http.Request, sess *Session, reason string) {
	ev := loginEvent{}
	if r != nil {
		ev = requestEvent(r, "")
	}
	s.record(s.sessionEvent(ev, sess, eventRevoked, reason))
}

func (s *SSO) consumeState(state string, expires int64) bool {
	now := time.Now().Unix()
	s.usedStates.Range(func(k, v any) bool {
		if v.(int64) < now {
			s.usedStates.Delete(k)
		}
		return true
	})
	_, used := s.usedStates.LoadOrStore(state, expires)
	return !used
}

// ---------- 停用名单 ----------

// handleBlocklistChanged 收集成平台「名单变了」的提醒。提醒不带名单、不需要密钥：
// 假提醒最多让项目多读一次名单，名单只从集成平台读。
func (s *SSO) handleBlocklistChanged(w http.ResponseWriter, r *http.Request) {
	var hint struct {
		Revision int64 `json:"revision"`
	}
	_ = json.NewDecoder(io.LimitReader(r.Body, 4096)).Decode(&hint)
	local, synced, err := s.store.BlocklistRevision(r.Context())
	if err != nil || !synced || hint.Revision == 0 || hint.Revision > local {
		s.wakeSync()
	}
	writeJSON(w, http.StatusAccepted, map[string]any{"ok": true})
}

func (s *SSO) wakeSync() {
	select {
	case s.syncWake <- struct{}{}:
	default:
	}
}

func (s *SSO) syncLoop() {
	for range s.syncWake {
		for attempt := 0; attempt < syncAttempts; attempt++ {
			err := s.syncBlocklist()
			if err == nil {
				break
			}
			log.Printf("sso: blocklist sync attempt %d: %v", attempt+1, err)
			time.Sleep(time.Duration(5<<attempt) * time.Second)
		}
		time.Sleep(s.syncMinGap)
	}
}

func (s *SSO) syncBlocklist() error {
	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
	defer cancel()
	req, _ := http.NewRequestWithContext(ctx, http.MethodPost, s.blocklistURL, strings.NewReader("{}"))
	req.Header.Set("Content-Type", "application/json")
	resp, err := http.DefaultClient.Do(req)
	if err != nil {
		return err
	}
	defer resp.Body.Close()
	body, _ := io.ReadAll(io.LimitReader(resp.Body, 4<<20))
	if resp.StatusCode != http.StatusOK {
		return fmt.Errorf("blocklist HTTP %d", resp.StatusCode)
	}
	var got struct {
		Revision *int64 `json:"revision"`
		Complete *bool  `json:"complete"`
		Entries  []struct {
			Sub    string `json:"sub"`
			Reason string `json:"reason"`
			Since  string `json:"since"`
		} `json:"entries"`
	}
	if err := json.Unmarshal(body, &got); err != nil || got.Revision == nil || got.Complete == nil || got.Entries == nil {
		return fmt.Errorf("blocklist malformed: %.200s", body)
	}
	if !*got.Complete {
		return errors.New("blocklist incomplete, keeping the old one")
	}
	next := Blocklist{Revision: *got.Revision, SyncedAt: time.Now(), Entries: map[string]BlockEntry{}}
	for _, e := range got.Entries {
		if e.Sub != "" {
			next.Entries[e.Sub] = BlockEntry{Reason: e.Reason, Since: e.Since}
		}
	}
	// 先落名单再踢人：落盘失败就不换名单，下次提醒再来；新登录也是按落盘的名单拒绝。
	if err := s.store.SaveBlocklist(ctx, next); errors.Is(err, ErrStaleBlocklist) {
		log.Printf("sso: blocklist revision %d is older than the stored one, ignored", next.Revision)
		return nil
	} else if err != nil {
		return fmt.Errorf("save blocklist: %w", err)
	}
	kicked, err := s.store.DeleteSessionsBySub(ctx, next.Entries)
	if err != nil {
		return fmt.Errorf("end blocked sessions: %w", err)
	}
	for _, sess := range kicked {
		s.locks.Delete(sess.IDHash)
		s.retryAfter.Delete(sess.IDHash)
		s.recordRevoked(nil, &sess, "停用名单："+next.Entries[sess.Identity.Sub].Reason)
	}
	go func() {
		for _, sess := range kicked {
			if rt, err := s.open("refresh-token", sess.RefreshSeal); err == nil {
				rctx, cancel := context.WithTimeout(context.Background(), upstreamLimit)
				s.revoke(rctx, string(rt))
				cancel()
			}
		}
	}()
	log.Printf("sso: blocklist revision %d, %d blocked, %d sessions ended", next.Revision, len(next.Entries), len(kicked))
	return nil
}

// blocked 在登录时判断能不能放人。名单从没同步成功过，或者读不出来，一律不放：不按空名单放人。
func (s *SSO) blocked(ctx context.Context, sub string) (string, bool) {
	_, synced, err := s.store.BlocklistRevision(ctx)
	if err != nil {
		log.Printf("sso: load blocklist: %v", err)
		return "名单读不出来", true
	}
	if !synced {
		return "停用名单还没同步成功过", true
	}
	e, err := s.store.BlockedEntry(ctx, sub)
	if err != nil {
		log.Printf("sso: load blocklist: %v", err)
		return "名单读不出来", true
	}
	if e != nil {
		return e.Reason, true
	}
	return "", false
}

// ---------- 集成平台接口 ----------

type userInfo struct {
	Sub     string `json:"sub"`
	Name    string `json:"name"`
	Email   string `json:"email"`
	Picture string `json:"picture"`
}

func (s *SSO) userInfo(ctx context.Context, accessToken, wantSub string) (userInfo, error) {
	req, _ := http.NewRequestWithContext(ctx, http.MethodGet, s.userInfoURL, nil)
	req.Header.Set("Authorization", "Bearer "+accessToken)
	resp, err := http.DefaultClient.Do(req)
	if err != nil {
		return userInfo{}, err
	}
	defer resp.Body.Close()
	body, _ := io.ReadAll(io.LimitReader(resp.Body, 1<<20))
	switch {
	case resp.StatusCode == http.StatusForbidden:
		return userInfo{}, fmt.Errorf("%w: userinfo HTTP 403", errDenied)
	case resp.StatusCode == http.StatusUnauthorized:
		return userInfo{}, fmt.Errorf("%w: userinfo HTTP 401", errTokenStale)
	case resp.StatusCode != http.StatusOK:
		return userInfo{}, fmt.Errorf("userinfo HTTP %d", resp.StatusCode)
	}
	var info userInfo
	if err := json.Unmarshal(body, &info); err != nil {
		return userInfo{}, fmt.Errorf("userinfo malformed: %w", err)
	}
	if info.Sub != wantSub {
		return userInfo{}, fmt.Errorf("%w: userinfo sub mismatch", errDenied)
	}
	return info, nil
}

func (s *SSO) revoke(ctx context.Context, refreshToken string) {
	if refreshToken == "" {
		return
	}
	form := url.Values{"token": {refreshToken}, "token_type_hint": {"refresh_token"}}
	req, _ := http.NewRequestWithContext(ctx, http.MethodPost, s.revokeURL, strings.NewReader(form.Encode()))
	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
	req.SetBasicAuth(url.QueryEscape(s.oauth.ClientID), url.QueryEscape(s.oauth.ClientSecret))
	resp, err := http.DefaultClient.Do(req)
	if err != nil {
		log.Printf("sso: revoke: %v", err)
		return
	}
	resp.Body.Close()
	if resp.StatusCode != http.StatusOK {
		log.Printf("sso: revoke HTTP %d", resp.StatusCode)
	}
}

func definiteRejection(err error) bool {
	var re *oauth2.RetrieveError
	return errors.As(err, &re) && re.Response != nil && re.Response.StatusCode >= 400 && re.Response.StatusCode < 500
}

func oauthErr(err error) string {
	var re *oauth2.RetrieveError
	if errors.As(err, &re) && re.Response != nil {
		return fmt.Sprintf("HTTP %d %s", re.Response.StatusCode, re.ErrorCode)
	}
	return err.Error()
}

// ---------- 账号密码 ----------

// handleAccountLogin 给没有飞书的外部供应商、兼职：POST JSON {username, password}，当场查一次账号表。
// 成功 200 并下发同一个会话 cookie；不让进一律 401 auth_failed（真实原因只写日志）；连错太多 429 rate_limited；
// 账号表查不了 503 login_service_unavailable（不放人，也不算连错）。
func (s *SSO) handleAccountLogin(w http.ResponseWriter, r *http.Request) {
	// 只收 JSON：跨站页面不经预检发不出这个类型，别人没法悄悄把你登进他的账号。
	if mt, _, _ := mime.ParseMediaType(r.Header.Get("Content-Type")); mt != "application/json" {
		writeJSON(w, http.StatusUnsupportedMediaType, map[string]any{"error": "json_required"})
		return
	}
	var in struct {
		Username string `json:"username"`
		Password string `json:"password"`
	}
	_ = json.NewDecoder(io.LimitReader(r.Body, 4096)).Decode(&in)
	name := normalizeUsername(in.Username)
	// 密码前后不会有空白；转发时常多带一个空格或换行。
	password := strings.TrimSpace(in.Password)
	ev := requestEvent(r, methodAccount)
	ev.Account = clip(strings.TrimSpace(in.Username), 100)
	if !s.allowAttempt(name) {
		ev.Event, ev.Reason = eventLoginFail, "已锁定"
		s.record(ev)
		writeJSON(w, http.StatusTooManyRequests, map[string]any{"error": "rate_limited"})
		return
	}
	var found []accountRow // 按账号查到的行，拒绝时把它们的「状态」一起对一遍
	refuse := func(row *accountRow, reason string) {
		_, locked := s.recordFailure(name)
		// 凑满 5 次时 writeStatuses 会把这一行写成「已锁定」和解锁时间。
		s.writeStatuses(found)
		if locked {
			reason += "（连错 5 次，已锁定）"
		}
		if row != nil {
			ev.RecordID = row.ID
		}
		log.Printf("sso: account login %q refused: %s", name, reason)
		ev.Event, ev.Reason = eventLoginFail, reason
		s.record(ev)
		writeJSON(w, http.StatusUnauthorized, map[string]any{"error": "auth_failed"})
	}
	switch {
	case s.accountsTable == nil:
		refuse(nil, "本项目没开账号密码登录")
		return
	case name == "":
		refuse(nil, "没填账号")
		return
	case password == "":
		refuse(nil, "没填密码")
		return
	}
	ctx, cancel := context.WithTimeout(r.Context(), upstreamLimit)
	defer cancel()
	rows, err := s.findAccount(ctx, name)
	found = rows
	if err != nil {
		log.Printf("sso: account login %q: accounts table: %v", name, err)
		ev.Event, ev.Reason = eventLoginFail, "查表失败"
		s.record(ev)
		writeJSON(w, http.StatusServiceUnavailable, map[string]any{"error": "login_service_unavailable"})
		return
	}
	row, reason := s.loginVerdict(rows, password)
	if reason != "" {
		refuse(row, reason)
		return
	}
	s.clearFailures(name)
	id := Identity{CompanyCode: accountCompanyCode, Sub: row.ID, Name: strings.TrimSpace(row.Username)}
	ev = withIdentity(ev, id)
	ev.RecordID = row.ID
	userID, err := s.onLogin(ctx, id)
	if errors.Is(err, ErrNotAllowed) {
		refuse(row, "本项目不让进")
		return
	} else if err != nil {
		log.Printf("sso: OnLogin %s: %v", id.Key(), err)
		ev.Event, ev.Reason = eventLoginFail, "OnLogin 出错"
		s.record(ev)
		writeJSON(w, http.StatusServiceUnavailable, map[string]any{"error": "login_service_unavailable"})
		return
	}
	sid := randToken()
	now := time.Now()
	sess := Session{IDHash: hashID(sid), UserID: userID, Identity: id, CreatedAt: now, CheckedAt: now, LastSeenAt: now, Version: 1,
		Account: true, AccountCredential: s.credential(row.Password), Features: s.checkedFeatures(*row)}
	if err := s.store.CreateSession(ctx, sess); err != nil {
		log.Printf("sso: create session: %v", err)
		ev.Event, ev.Reason = eventLoginFail, "建会话失败"
		s.record(ev)
		writeJSON(w, http.StatusServiceUnavailable, map[string]any{"error": "login_service_unavailable"})
		return
	}
	setCookie(w, sessionCookie, sid, sessionIdle+touchEvery)
	log.Printf("sso: login %s user=%s", id.Key(), userID)
	s.writeBack(row.ID, map[string]any{colStatus: statusOK, colNote: "", colLastLogin: now.UnixMilli()})
	ev.Event, ev.Session, ev.Permissions = eventLoginOK, sessionTag(sess.IDHash), s.permissionColumns(sess.Features)
	s.record(ev)
	writeJSON(w, http.StatusOK, map[string]any{"ok": true})
}

// loginVerdict 判这次账号登录：返回对上的那一行，不让进时返回原因（只写日志，不回给浏览器）。
func (s *SSO) loginVerdict(rows []accountRow, password string) (*accountRow, string) {
	switch {
	case len(rows) == 0:
		return nil, "账号不存在"
	case len(rows) > 1:
		return nil, "账号重复"
	}
	row := &rows[0]
	stored := strings.TrimSpace(row.Password)
	if stored == "" {
		return row, "配置有误：缺密码"
	}
	if !s.samePassword(stored, password) {
		return row, "密码不对"
	}
	if row.Enabled != enabledValue {
		return row, enabledRefusal(row.Enabled)
	}
	return row, ""
}

// enabledRefusal 是「账号状态」不是启用时的原因：只有一字不差的「启用」能登录，空的、禁用、改了名的选项都不行。
func enabledRefusal(v string) string {
	if v == "" || v == disabledValue {
		return "账号已停用"
	}
	return "账号状态的值不认识：" + v
}

// samePassword 把两边都用本进程的随机密钥做 HMAC 再定长比较，比较耗时和密码长短、对错都无关。
func (s *SSO) samePassword(a, b string) bool {
	return subtle.ConstantTimeCompare(hmacSum(s.compareKey, a), hmacSum(s.compareKey, b)) == 1
}

// credential 是存进会话的密码指纹：表里改了密码指纹就变，会话里又不存密码本身。
func (s *SSO) credential(password string) string {
	return hex.EncodeToString(hmacSum(s.credKey, strings.TrimSpace(password)))[:16]
}

func (s *SSO) allowAttempt(name string) bool {
	s.failMu.Lock()
	defer s.failMu.Unlock()
	f := s.fails[name]
	return f == nil || f.n < accountFailLimit || time.Since(f.first) > accountLockFor
}

// recordFailure 记一次失败；这一次正好凑满 5 次时返回解锁时间和 true。
func (s *SSO) recordFailure(name string) (time.Time, bool) {
	s.failMu.Lock()
	defer s.failMu.Unlock()
	if len(s.fails) > 10_000 {
		for k, f := range s.fails {
			if time.Since(f.first) > accountLockFor {
				delete(s.fails, k)
			}
		}
	}
	f := s.fails[name]
	if f == nil || time.Since(f.first) > accountLockFor {
		f = &accountFails{first: time.Now()}
		s.fails[name] = f
	}
	f.n++
	return f.first.Add(accountLockFor), f.n == accountFailLimit
}

func (s *SSO) clearFailures(name string) {
	s.failMu.Lock()
	defer s.failMu.Unlock()
	delete(s.fails, name)
}

// lockedNames 是此刻锁着的账号 → 解锁时间。
func (s *SSO) lockedNames() map[string]time.Time {
	s.failMu.Lock()
	defer s.failMu.Unlock()
	out := map[string]time.Time{}
	for k, f := range s.fails {
		if f.n >= accountFailLimit && time.Since(f.first) <= accountLockFor {
			out[k] = f.first.Add(accountLockFor)
		}
	}
	return out
}

func lockNote(until time.Time) string {
	return fmt.Sprintf("连续输错 %d 次，%s 后自动解锁", accountFailLimit, until.In(chinaTime).Format("15:04"))
}

// checkAccount 每个核对周期按 record_id 读一次那一行：删了、账号状态不是启用、密码改了就下线，否则更新功能和名字。
// 账号表读不到时普通接口最多再放行 15 分钟。
func (s *SSO) checkAccount(ctx context.Context, r *http.Request, sess *Session) (*Session, int) {
	if s.accountsTable == nil {
		s.revokeSession(ctx, r, sess.IDHash, "本项目没开账号密码登录")
		return nil, http.StatusUnauthorized
	}
	mu, _ := s.locks.LoadOrStore(sess.IDHash, &sync.Mutex{})
	mu.(*sync.Mutex).Lock()
	defer mu.(*sync.Mutex).Unlock()
	cur, err := s.store.GetSession(ctx, sess.IDHash)
	if err != nil {
		return nil, http.StatusServiceUnavailable
	}
	if cur == nil {
		return nil, http.StatusUnauthorized
	}
	if time.Since(cur.CheckedAt) < s.checkEvery {
		return cur, http.StatusOK
	}
	inGrace := time.Since(cur.CheckedAt) < s.checkEvery+outageGrace
	if until, ok := s.retryAfter.Load(cur.IDHash); ok && time.Now().Before(until.(time.Time)) {
		if inGrace {
			return cur, http.StatusOK
		}
		return nil, http.StatusServiceUnavailable
	}
	cctx, cancel := context.WithTimeout(ctx, upstreamLimit)
	defer cancel()
	rec, err := s.feishu.get(cctx, *s.accountsTable, cur.Identity.Sub)
	if errors.Is(err, errRecordNotFound) {
		s.accountsRead(nil)
		s.revokeSession(ctx, r, cur.IDHash, "账号已删除")
		return nil, http.StatusUnauthorized
	}
	if err != nil {
		s.accountsRead(err)
		log.Printf("sso: check account %s: %v", cur.Identity.Sub, err)
		s.retryAfter.Store(cur.IDHash, time.Now().Add(outageBackoff))
		if inGrace {
			return cur, http.StatusOK
		}
		return nil, http.StatusServiceUnavailable
	}
	s.accountsRead(nil)
	s.retryAfter.Delete(cur.IDHash)
	row := parseAccountRow(rec)
	if reason := s.revokeReason(row, cur.AccountCredential); reason != "" {
		log.Printf("sso: account %s %s, ending session", cur.Identity.Sub, reason)
		s.revokeSession(ctx, r, cur.IDHash, reason)
		return nil, http.StatusUnauthorized
	}
	next := *cur
	next.CheckedAt = time.Now()
	next.Identity.Name = strings.TrimSpace(row.Username)
	next.Features = s.checkedFeatures(row)
	if err := s.store.UpdateSession(ctx, next, cur.Version); err != nil {
		again, gerr := s.store.GetSession(ctx, cur.IDHash)
		if gerr != nil {
			return nil, http.StatusServiceUnavailable
		}
		if again == nil {
			return nil, http.StatusUnauthorized
		}
		return again, http.StatusOK
	}
	next.Version = cur.Version + 1
	return &next, http.StatusOK
}

// revokeReason 是登着的账号会话要下线的原因，空串是不用下线。
func (s *SSO) revokeReason(row accountRow, credential string) string {
	if row.Enabled != enabledValue {
		return "账号已停用"
	}
	if s.credential(row.Password) != credential {
		return "密码已改"
	}
	return ""
}

// findAccount 按账号当场查表。表里的「是」不分大小写，查回来再按去空格、转小写后完全相等过一遍。
func (s *SSO) findAccount(ctx context.Context, name string) ([]accountRow, error) {
	filter := map[string]any{"conjunction": "and", "conditions": []any{
		map[string]any{"field_name": colUsername, "operator": "is", "value": []string{name}},
	}}
	recs, err := s.feishu.search(ctx, *s.accountsTable, filter, nil, 10)
	if err != nil {
		s.accountsRead(err)
		return nil, err
	}
	s.accountsRead(nil)
	var rows []accountRow
	for _, rec := range recs {
		if row := parseAccountRow(rec); normalizeUsername(row.Username) == name {
			rows = append(rows, row)
		}
	}
	return rows, nil
}

func normalizeUsername(v string) string { return strings.ToLower(strings.TrimSpace(v)) }

// writeBack 把状态类的三列排进待写队列；只会是 状态、状态说明、最近登录。
func (s *SSO) writeBack(recordID string, fields map[string]any) {
	s.outbox.add(outboxItem{Target: targetAccounts, RecordID: recordID, Fields: fields})
}

// ---------- 功能开关 ----------

// allFeatures 是此刻没被表结构问题关掉的全部功能（飞书登录的人就是这些）。
func (s *SSO) allFeatures() []string {
	broken := s.brokenFeatures()
	out := []string{}
	for _, f := range s.features {
		if !broken[f.Key] {
			out = append(out, f.Key)
		}
	}
	return out
}

func (s *SSO) featuresOf(sess *Session) []string {
	all := s.allFeatures()
	if !sess.Account {
		return all
	}
	out := []string{}
	for _, k := range all {
		if slices.Contains(sess.Features, k) {
			out = append(out, k)
		}
	}
	return out
}

func (s *SSO) checkedFeatures(row accountRow) []string {
	out := []string{}
	for _, f := range s.features {
		if row.Checked[f.Column] {
			out = append(out, f.Key)
		}
	}
	return out
}

func (s *SSO) permissionColumns(keys []string) string {
	var cols []string
	for _, f := range s.features {
		if slices.Contains(keys, f.Key) {
			cols = append(cols, f.Column)
		}
	}
	return strings.Join(cols, "、")
}

func (s *SSO) brokenFeatures() map[string]bool {
	s.healthMu.Lock()
	defer s.healthMu.Unlock()
	broken := map[string]bool{}
	for code := range s.issues[targetAccounts] {
		if k, ok := strings.CutPrefix(code, "feature_column:"); ok {
			broken[k] = true
		}
	}
	return broken
}

// ---------- 兜底对账、账号表变更提醒 ----------

// reconcileLoop 是事件丢了时的兜底，跟着进程启动、不会停：先跑一轮，之后每 reconcileEvery 一轮。
// 一轮做这几件事：重拉停用名单；待写队列有积压就马上排一次；查两张表的结构；整表读账号表，
// 收回已删除、已停用、改了密码的账号会话，「状态」「状态说明」对不上的行写回（只写对不上的）。
// 读表失败按 1 秒起翻倍重试（最长 5 分钟），成功了再等下一轮。
func (s *SSO) reconcileLoop() {
	for {
		s.wakeSync()
		if s.outbox != nil {
			s.outbox.kickBacklog()
		}
		backoff := time.Second
		for !s.reconcileOnce() {
			time.Sleep(backoff)
			backoff = min(backoff*2, outboxMaxBackoff, s.reconcileEvery)
		}
		time.Sleep(s.reconcileEvery)
	}
}

func (s *SSO) reconcileOnce() bool {
	ctx, cancel := context.WithTimeout(context.Background(), time.Minute)
	defer cancel()
	if !s.checkSchema(ctx) {
		return false
	}
	if s.accountsTable == nil {
		return true
	}
	readAt := time.Now()
	recs, err := s.feishu.search(ctx, *s.accountsTable, nil, nil, 200)
	s.accountsRead(err)
	if err != nil {
		log.Printf("sso: accounts table reconcile: %v", err)
		return false
	}
	sessions, err := s.store.AccountSessions(ctx)
	if err != nil {
		log.Printf("sso: reconcile: load account sessions: %v", err)
		return false
	}
	rows := map[string]accountRow{}
	groups := map[string][]accountRow{}
	for _, rec := range recs {
		row := parseAccountRow(rec)
		rows[row.ID] = row
		key := normalizeUsername(row.Username)
		groups[key] = append(groups[key], row)
	}
	ended := 0
	for _, sess := range sessions {
		// 读表之后才登录或核对过的会话不动：它比这份表新。
		if sess.CheckedAt.After(readAt) {
			continue
		}
		var row *accountRow
		if r, ok := rows[sess.Identity.Sub]; ok {
			row = &r
		}
		if !s.settleAccountSession(ctx, sess, row) {
			ended++
		}
	}
	for _, g := range groups {
		s.writeStatuses(g)
	}
	log.Printf("sso: reconcile: %d account rows, %d sessions checked, %d ended", len(recs), len(sessions), ended)
	return true
}

// checkSchema 查两张表的列，换上新的表结构问题；有一张读不到返回 false。
func (s *SSO) checkSchema(ctx context.Context) bool {
	ok := true
	if s.accountsTable != nil {
		fields, err := s.feishu.fields(ctx, *s.accountsTable)
		s.accountsRead(err)
		if err != nil {
			log.Printf("sso: accounts table fields: %v", err)
			ok = false
		} else {
			s.setIssues(targetAccounts, accountSchemaIssues(fields, s.features))
		}
	}
	if s.logTable != nil {
		if fields, err := s.feishu.fields(ctx, *s.logTable); err != nil {
			log.Printf("sso: log table fields: %v", err)
			ok = false
		} else {
			s.setIssues(targetLog, columnIssues("log_column:", fields, logColumns))
		}
	}
	return ok
}

// writeStatuses 把同一个账号名的几行的「状态」「状态说明」算一遍，对不上的写回。
func (s *SSO) writeStatuses(rows []accountRow) {
	locked := s.lockedNames()
	for _, row := range rows {
		if row.blank() {
			continue
		}
		status, note := accountRowStatus(rowFacts{row: row, duplicate: len(rows) > 1, lockedUntil: locked[normalizeUsername(row.Username)]})
		if status != row.Status || note != row.Note {
			s.writeBack(row.ID, map[string]any{colStatus: status, colNote: note})
		}
	}
}

// 账号表的自动化在人改了账号、密码、账号状态、功能列后 POST {"record_id":"rec…"}。
// 提醒不需要密钥，伪造了也无害：马上回 202、不回任何数据，只当场读那一行。
func (s *SSO) handleAccountsChanged(w http.ResponseWriter, r *http.Request) {
	var in struct {
		RecordID string `json:"record_id"`
	}
	_ = json.NewDecoder(io.LimitReader(r.Body, 4096)).Decode(&in)
	w.WriteHeader(http.StatusAccepted)
	if s.accountsTable == nil || !recordIDFormat.MatchString(in.RecordID) {
		return
	}
	if s.claimChange(in.RecordID) {
		go s.processChanges(in.RecordID)
	}
}

// claimChange 同一行正在处理时只记一笔「处理完再来一遍」；全局最近一分钟最多处理 60 次，多的丢掉（用户下一个请求照样会核对）。
func (s *SSO) claimChange(id string) bool {
	s.changedMu.Lock()
	defer s.changedMu.Unlock()
	if _, busy := s.changing[id]; busy {
		s.changing[id] = true
		return false
	}
	now := time.Now()
	s.changedTimes = slices.DeleteFunc(s.changedTimes, func(t time.Time) bool { return now.Sub(t) > time.Minute })
	if len(s.changedTimes) >= accountsChangedPerMinute {
		return false
	}
	s.changedTimes = append(s.changedTimes, now)
	s.changing[id] = false
	return true
}

func (s *SSO) processChanges(id string) {
	for {
		s.applyAccountChange(id)
		s.changedMu.Lock()
		if !s.changing[id] {
			delete(s.changing, id)
			s.changedMu.Unlock()
			return
		}
		s.changing[id] = false
		s.changedMu.Unlock()
	}
}

// applyAccountChange 读那一行：删了、账号状态不是启用、密码改了，就让绑在这一行上的会话全部下线；
// 否则更新名字和功能。最后把同名几行的「状态」对一遍。不认识的 record_id 什么都不做。
func (s *SSO) applyAccountChange(id string) {
	ctx, cancel := context.WithTimeout(context.Background(), time.Minute)
	defer cancel()
	s.checkSchema(ctx)
	rec, err := s.feishu.get(ctx, *s.accountsTable, id)
	s.accountsRead(err)
	if err != nil && !errors.Is(err, errRecordNotFound) {
		log.Printf("sso: accounts-changed %s: %v", id, err)
		return
	}
	sessions, serr := s.store.AccountSessions(ctx)
	if serr != nil {
		log.Printf("sso: accounts-changed %s: load sessions: %v", id, serr)
	}
	var row *accountRow
	if err == nil {
		r := parseAccountRow(rec)
		row = &r
	}
	for _, sess := range sessions {
		if sess.Identity.Sub == id {
			s.settleAccountSession(ctx, sess, row)
		}
	}
	if row == nil {
		return
	}
	// 同名的几行一起对（这一行改了名，可能和别的行重了）。
	group := []accountRow{*row}
	if name := normalizeUsername(row.Username); name != "" {
		if rows, err := s.findAccount(ctx, name); err == nil {
			group = rows
			if !slices.ContainsFunc(rows, func(r accountRow) bool { return r.ID == id }) {
				group = append(group, *row)
			}
		}
	}
	s.writeStatuses(group)
}

// settleAccountSession 按刚读到的那一行处理一个账号会话（row 为 nil 是那一行删了）：
// 删了、账号状态不是启用、密码改了就下线，返回 false；否则更新名字和功能，返回 true。
func (s *SSO) settleAccountSession(ctx context.Context, sess Session, row *accountRow) bool {
	reason := "账号已删除"
	if row != nil {
		reason = s.revokeReason(*row, sess.AccountCredential)
	}
	if reason != "" {
		log.Printf("sso: account %s %s, ending session", sess.Identity.Sub, reason)
		s.revokeSession(ctx, nil, sess.IDHash, reason)
		return false
	}
	next := sess
	next.Identity.Name = strings.TrimSpace(row.Username)
	next.Features = s.checkedFeatures(*row)
	next.CheckedAt = time.Now()
	// 版本对不上就算了：用户的下一个请求还会核对。
	_ = s.store.UpdateSession(ctx, next, sess.Version)
	return true
}

type rowFacts struct {
	row         accountRow
	duplicate   bool
	lockedUntil time.Time
}

// accountRowRules 按顺序判一行的「状态」和「状态说明」，第一条对上的算数；都不对上就是正常。
var accountRowRules = []struct {
	applies func(rowFacts) bool
	status  string
	note    func(rowFacts) string
}{
	{func(f rowFacts) bool { return strings.TrimSpace(f.row.Username) == "" }, statusMisconfigured, fixedNote("缺账号")},
	{func(f rowFacts) bool { return f.row.Username != strings.TrimSpace(f.row.Username) }, statusMisconfigured, fixedNote("账号前后有空格")},
	{func(f rowFacts) bool { return strings.TrimSpace(f.row.Password) == "" }, statusMisconfigured, fixedNote("缺密码")},
	{func(f rowFacts) bool { return f.duplicate }, statusMisconfigured, fixedNote("账号重复")},
	{func(f rowFacts) bool { return !knownEnabled(f.row.Enabled) }, statusMisconfigured, func(f rowFacts) string { return "账号状态的值不认识：" + f.row.Enabled }},
	{func(f rowFacts) bool { return f.row.Enabled != enabledValue }, statusDisabled, func(f rowFacts) string {
		if f.row.Enabled == "" {
			return "账号状态没选，选「启用」才能登录"
		}
		return ""
	}},
	{func(f rowFacts) bool { return !f.lockedUntil.IsZero() }, statusLocked, func(f rowFacts) string { return lockNote(f.lockedUntil) }},
}

func knownEnabled(v string) bool { return v == "" || v == enabledValue || v == disabledValue }

func fixedNote(note string) func(rowFacts) string { return func(rowFacts) string { return note } }

func accountRowStatus(f rowFacts) (string, string) {
	for _, rule := range accountRowRules {
		if rule.applies(f) {
			return rule.status, rule.note(f)
		}
	}
	return statusOK, ""
}

// accountSchemaIssues 检查账号表的列：系统要读写的列、代码里声明的功能列都得在、类型都得对；没声明的复选框只提醒。
func accountSchemaIssues(fields []tableField, features []Feature) map[string]string {
	issues := columnIssues("accounts_column:", fields, accountColumns)
	byName := map[string]tableField{}
	for _, f := range fields {
		byName[f.Name] = f
	}
	declared := map[string]bool{}
	for _, feat := range features {
		declared[feat.Column] = true
		if f, ok := byName[feat.Column]; !ok {
			issues["feature_column:"+feat.Key] = "复选框列「" + feat.Column + "」不存在，功能 " + feat.Key + " 对所有人关掉"
		} else if f.Type != fieldCheckbox {
			issues["feature_column:"+feat.Key] = fmt.Sprintf("列「%s」类型是 %d 不是复选框，功能 %s 对所有人关掉", feat.Column, f.Type, feat.Key)
		}
	}
	for _, f := range fields {
		if f.Type == fieldCheckbox && !declared[f.Name] {
			issues["warn_undeclared_checkbox:"+f.Name] = "复选框列「" + f.Name + "」代码里没声明，不起作用"
		}
	}
	return issues
}

func columnIssues(prefix string, fields []tableField, want []column) map[string]string {
	byName := map[string]tableField{}
	for _, f := range fields {
		byName[f.Name] = f
	}
	issues := map[string]string{}
	for _, c := range want {
		if f, ok := byName[c.name]; !ok {
			issues[prefix+c.name] = "列「" + c.name + "」不存在"
		} else if f.Type != c.typ && !(c.typ == fieldLink && f.Type == fieldDuplex) {
			issues[prefix+c.name] = fmt.Sprintf("列「%s」类型是 %d，应为 %d", c.name, f.Type, c.typ)
		}
	}
	return issues
}

// setIssues 换上新的表结构问题，出现和消失各记一行 stderr。
func (s *SSO) setIssues(table string, next map[string]string) {
	s.healthMu.Lock()
	prev := s.issues[table]
	s.issues[table] = next
	s.healthMu.Unlock()
	for code, detail := range next {
		if _, ok := prev[code]; !ok {
			log.Printf("sso: table problem %s: %s", code, detail)
		}
	}
	for code := range prev {
		if _, ok := next[code]; !ok {
			log.Printf("sso: table problem cleared: %s", code)
		}
	}
}

// accountsRead 记下最近一次读账号表成没成功，健康检查据此报 accounts_unreachable。
func (s *SSO) accountsRead(err error) {
	s.healthMu.Lock()
	s.accountsFailed = err != nil && !errors.Is(err, errRecordNotFound)
	s.healthMu.Unlock()
}

// ---------- 健康检查 ----------

// handleHealth 给监控读：不带个人信息、表 ID、错误原文。有问题回 503。
func (s *SSO) handleHealth(w http.ResponseWriter, r *http.Request) {
	problems := []string{}
	s.healthMu.Lock()
	for _, table := range []string{targetAccounts, targetLog} {
		for code := range s.issues[table] {
			problems = append(problems, code)
		}
	}
	if s.accountsFailed {
		problems = append(problems, "accounts_unreachable")
	}
	s.healthMu.Unlock()
	pending, oldest, dropped := 0, 0, int64(0)
	if s.outbox != nil {
		st := s.outbox.stats()
		pending, dropped = st.pending, st.dropped
		if !st.oldest.IsZero() {
			oldest = int(time.Since(st.oldest).Seconds())
		}
		if !st.droppedAt.IsZero() && time.Since(st.droppedAt) < droppedWarnFor {
			problems = append(problems, "warn_request_rows_dropped")
		}
		if time.Duration(oldest)*time.Second > outboxStaleAfter {
			problems = append(problems, "outbox_stale")
		}
		if pending > outboxBacklogLimit {
			problems = append(problems, "outbox_backlog")
		}
		if st.saveFailed {
			problems = append(problems, "outbox_write_failed")
		}
	}
	slices.Sort(problems)
	ok := !slices.ContainsFunc(problems, func(p string) bool { return !strings.HasPrefix(p, "warn_") })
	status := http.StatusOK
	if !ok {
		status = http.StatusServiceUnavailable
	}
	writeJSON(w, status, map[string]any{"ok": ok, "outbox_pending": pending, "oldest_pending_seconds": oldest, "dropped_request_rows": dropped, "problems": problems})
}

// ---------- 登录日志 ----------

// loginEvent 是日志表里的一行。密码、令牌、授权码、state、cookie、请求体、查询串一律不进来。
type loginEvent struct {
	Event, Reason, Method                  string
	Company, Subject, Name, Email, Account string
	RecordID, Permissions                  string
	IP, IPSource, Browser, Next, Session   string
	// 只有「请求」行有：HTTP 方法、不带查询串的路径、状态码、耗时
	Verb, Path string
	Status     int
	DurationMS int64
	mergeKey   string // 同一窗口里方法、路径、状态码、人（没登录按 IP）都一样的请求合成一行
}

func requestEvent(r *http.Request, method string) loginEvent {
	ip, source := clientIP(r)
	return loginEvent{Method: method, IP: ip, IPSource: source, Browser: r.UserAgent()}
}

func withIdentity(ev loginEvent, id Identity) loginEvent {
	ev.Company, ev.Subject, ev.Name, ev.Email = id.CompanyCode, id.Sub, id.Name, id.Email
	return ev
}

func (s *SSO) sessionEvent(ev loginEvent, sess *Session, event, reason string) loginEvent {
	ev = withIdentity(ev, sess.Identity)
	ev.Event, ev.Reason, ev.Session = event, reason, sessionTag(sess.IDHash)
	ev.Method = methodFeishu
	if sess.Account {
		ev.Method, ev.RecordID, ev.Account = methodAccount, sess.Identity.Sub, sess.Identity.Name
	}
	ev.Permissions = s.permissionColumns(s.featuresOf(sess))
	return ev
}

func (e loginEvent) summary() string {
	var who string
	switch {
	case e.Method == methodAccount && (e.Account != "" || e.Name != ""):
		who = "账号 " + cmpOr(e.Account, e.Name) + " "
	case e.Method == methodAccount:
		who = "账号密码"
	case e.Name != "":
		who = e.Name + "（飞书）"
	case e.Event == eventRequest && e.Company == "":
		who = "未登录 "
	default:
		who = "飞书"
	}
	what := e.Event
	if e.Event == eventRequest {
		if !strings.HasSuffix(who, " ") && !strings.HasSuffix(who, "）") {
			who += " "
		}
		what = fmt.Sprintf("%s %s %d", e.Verb, e.Path, e.Status)
	}
	if e.Reason == "" {
		return who + what
	}
	return who + what + "：" + e.Reason
}

// typeAndResult 把事件拆成日志的「类型」「结果」；被收回不写结果。
func (e loginEvent) typeAndResult() (string, string) {
	switch e.Event {
	case eventLoginOK:
		return typeLogin, resultOK
	case eventLoginFail:
		return typeLogin, resultFail
	case eventLogout:
		return typeLogout, resultOK
	case eventRequest:
		if e.Status < 400 {
			return typeRequest, resultOK
		}
		return typeRequest, resultFail
	}
	return typeRevoked, ""
}

// record 把一条日志排进待写队列；没配日志表就只留 stderr。登录和请求从不等它。
func (s *SSO) record(e loginEvent) {
	if s.logTable == nil {
		return
	}
	typ, result := e.typeAndResult()
	f := map[string]any{"摘要": clip(e.summary(), 200), "时间": time.Now().UnixMilli(), "项目": []string{s.projectRec}, "类型": typ, "次数": 1}
	if result != "" {
		f["结果"] = result
	}
	if e.Status != 0 {
		f["状态码"], f["耗时毫秒"] = e.Status, e.DurationMS
	}
	for _, kv := range []struct {
		col, val string
		max      int
	}{
		{"原因", e.Reason, 200}, {"登录方式", e.Method, 20}, {"公司", e.Company, 50},
		{"用户标识", e.Subject, 100}, {"姓名", e.Name, 100}, {"邮箱", e.Email, 200}, {"账号", e.Account, 100},
		{"记录ID", e.RecordID, 100}, {"权限", e.Permissions, 500}, {"方法", e.Verb, 10}, {"路径", e.Path, 500},
		{"IP", e.IP, 100}, {"IP来源", e.IPSource, 50}, {"浏览器", e.Browser, 500}, {"登录后去哪", e.Next, 500}, {"会话", e.Session, 12},
	} {
		if kv.val != "" {
			f[kv.col] = clip(kv.val, kv.max)
		}
	}
	s.outbox.add(outboxItem{Target: targetLog, Fields: f, Merge: e.mergeKey})
}

// ---------- 请求日志 ----------

// 本模板自己的路由不记请求日志：登录、退出另有登录日志，/api/me 和两个提醒、健康检查是探针。
var ownPaths = map[string]bool{
	loginPath: true, callbackPath: true, accountPath: true, logoutPath: true, mePath: true,
	blocklistPath: true, accountsChangedPath: true, healthPath: true,
}

type noteKey struct{}

// requestNote 是 Middleware 给每个请求开的小本子，RequireUser、Audit 往里记。
type requestNote struct {
	mu           sync.Mutex
	sess         *Session
	fresh, audit bool
}

func noteOf(r *http.Request) *requestNote {
	n, _ := r.Context().Value(noteKey{}).(*requestNote)
	return n
}

// Audit 让这个请求一定记进日志：导出、下载这类要留痕的接口在处理函数里调一下。要在 Middleware 包住的请求里才起作用。
func Audit(r *http.Request) {
	if n := noteOf(r); n != nil {
		n.mu.Lock()
		n.audit = true
		n.mu.Unlock()
	}
}

// Middleware 包住整个 mux 记请求日志，只记这几种：401、403、5xx、改数据的请求（POST/PUT/PATCH/DELETE，任何状态）、
// 敏感接口（RequireFreshUser）、调了 Audit 的接口。普通的成功 GET 和 404 不记。只记方法、不带查询串的路径、状态码、耗时、
// 谁（有会话时）、IP、浏览器；请求体、查询串、cookie 和别的请求头一概不记。没配日志表时原样放行。
func (s *SSO) Middleware(next http.Handler) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if s.logTable == nil || ownPaths[r.URL.Path] {
			next.ServeHTTP(w, r)
			return
		}
		start := time.Now()
		note := &requestNote{}
		sw := &statusWriter{ResponseWriter: w}
		defer func() {
			if p := recover(); p != nil {
				s.logRequest(r, note, http.StatusInternalServerError, time.Since(start))
				panic(p)
			}
			s.logRequest(r, note, cmpOrInt(sw.status, http.StatusOK), time.Since(start))
		}()
		next.ServeHTTP(sw, r.WithContext(context.WithValue(r.Context(), noteKey{}, note)))
	})
}

func (s *SSO) logRequest(r *http.Request, note *requestNote, status int, took time.Duration) {
	note.mu.Lock()
	sess, fresh, audit := note.sess, note.fresh, note.audit
	note.mu.Unlock()
	mutating := r.Method == http.MethodPost || r.Method == http.MethodPut || r.Method == http.MethodPatch || r.Method == http.MethodDelete
	if !(status == http.StatusUnauthorized || status == http.StatusForbidden || status >= 500 || mutating || fresh || audit) {
		return
	}
	ev := requestEvent(r, "")
	ev.Event, ev.Verb, ev.Path, ev.Status, ev.DurationMS = eventRequest, r.Method, clip(r.URL.Path, 500), status, took.Milliseconds()
	switch {
	case status == http.StatusUnauthorized:
		ev.Reason = "没登录"
	case status == http.StatusForbidden:
		ev.Reason = "没有权限"
	case status >= 500:
		ev.Reason = "服务出错"
	}
	sid := ""
	if c, err := r.Cookie(sessionCookie); err == nil {
		sid = c.Value
	}
	// 查会话、排队都放到后台，响应不等它。
	go func() {
		if sess == nil && sid != "" {
			ctx, cancel := context.WithTimeout(context.Background(), upstreamLimit)
			sess, _ = s.store.GetSession(ctx, hashID(sid))
			cancel()
		}
		who := "ip:" + ev.IP
		if sess != nil {
			ev = s.sessionEvent(ev, sess, eventRequest, ev.Reason)
			who = sess.Identity.Key()
		}
		ev.mergeKey = strings.Join([]string{ev.Verb, ev.Path, strconv.Itoa(status), who}, "\x00")
		s.record(ev)
	}()
}

// statusWriter 记下状态码；Flush、Hijack 原样转给底下的 ResponseWriter（长连接、WebSocket 照常用）。
type statusWriter struct {
	http.ResponseWriter
	status int
}

func (w *statusWriter) WriteHeader(code int) {
	if w.status == 0 {
		w.status = code
	}
	w.ResponseWriter.WriteHeader(code)
}

func (w *statusWriter) Write(b []byte) (int, error) {
	if w.status == 0 {
		w.status = http.StatusOK
	}
	return w.ResponseWriter.Write(b)
}

func (w *statusWriter) Unwrap() http.ResponseWriter { return w.ResponseWriter }

func (w *statusWriter) Flush() {
	if w.status == 0 {
		w.status = http.StatusOK
	}
	_ = http.NewResponseController(w.ResponseWriter).Flush()
}

func (w *statusWriter) Hijack() (net.Conn, *bufio.ReadWriter, error) {
	if w.status == 0 {
		w.status = http.StatusSwitchingProtocols
	}
	return http.NewResponseController(w.ResponseWriter).Hijack()
}

func cmpOrInt(v, fallback int) int {
	if v != 0 {
		return v
	}
	return fallback
}

// clientIP 依次认 X-Real-IP、X-Forwarded-For 第一个、直连地址，并记下用的是哪个。
func clientIP(r *http.Request) (string, string) {
	if v := strings.TrimSpace(r.Header.Get("X-Real-IP")); v != "" {
		return v, "X-Real-IP"
	}
	if first, _, _ := strings.Cut(r.Header.Get("X-Forwarded-For"), ","); strings.TrimSpace(first) != "" {
		return strings.TrimSpace(first), "X-Forwarded-For"
	}
	host, _, err := net.SplitHostPort(r.RemoteAddr)
	if err != nil {
		host = r.RemoteAddr
	}
	return host, "RemoteAddr"
}

// sessionTag 是会话 ID 哈希的前 12 位，日志里能把同一个会话的几行串起来，又倒推不出会话 ID。
func sessionTag(idHash string) string {
	if len(idHash) > 12 {
		return idHash[:12]
	}
	return idHash
}

var codeChars = regexp.MustCompile(`[^A-Za-z0-9_.-]`)

// cleanCode 只留外部传来的错误码里的安全字符。
func cleanCode(v string) string { return clip(codeChars.ReplaceAllString(v, ""), 64) }

func clip(v string, max int) string {
	if r := []rune(v); len(r) > max {
		return string(r[:max])
	}
	return v
}

func cmpOr(a, b string) string {
	if a != "" {
		return a
	}
	return b
}

// ---------- 小工具 ----------

func (s *SSO) seal(purpose string, plain []byte) string {
	nonce := make([]byte, s.aead.NonceSize())
	if _, err := rand.Read(nonce); err != nil {
		panic(err)
	}
	return base64.RawURLEncoding.EncodeToString(s.aead.Seal(nonce, nonce, plain, []byte(purpose)))
}

func (s *SSO) open(purpose, sealed string) ([]byte, error) {
	raw, err := base64.RawURLEncoding.DecodeString(sealed)
	if err != nil || len(raw) < s.aead.NonceSize() {
		return nil, errors.New("sso: bad seal")
	}
	n := s.aead.NonceSize()
	return s.aead.Open(nil, raw[:n], raw[n:], []byte(purpose))
}

func hmacSum(key []byte, msg string) []byte {
	m := hmac.New(sha256.New, key)
	m.Write([]byte(msg))
	return m.Sum(nil)
}

func envDuration(key string, fallback time.Duration) (time.Duration, error) {
	v := strings.TrimSpace(os.Getenv(key))
	if v == "" {
		return fallback, nil
	}
	d, err := time.ParseDuration(v)
	if err != nil || d <= 0 {
		return 0, fmt.Errorf("sso: bad %s %q", key, v)
	}
	return d, nil
}

// tableRef 是一张多维表格：app_token + table_id。
type tableRef struct{ App, Table string }

var (
	appTokenFormat = regexp.MustCompile(`^[A-Za-z0-9]{8,64}$`)
	tableIDFormat  = regexp.MustCompile(`^tbl[A-Za-z0-9]{4,32}$`)
	recordIDFormat = regexp.MustCompile(`^rec[A-Za-z0-9]{4,32}$`)
)

// envTable 读一个表配置：可以是浏览器地址栏里多维表格的链接（…/base/<app_token>?table=<table_id>&view=…），
// 也可以是 "<app_token>/<table_id>"。空的返回 nil。
func envTable(key string) (*tableRef, error) {
	v := strings.TrimSpace(os.Getenv(key))
	if v == "" {
		return nil, nil
	}
	var ref tableRef
	if strings.HasPrefix(v, "http://") || strings.HasPrefix(v, "https://") {
		u, err := url.Parse(v)
		if err != nil {
			return nil, fmt.Errorf("sso: %s is not a valid URL", key)
		}
		if strings.Contains(u.Path, "/wiki/") {
			return nil, fmt.Errorf("sso: %s is a wiki link; open the base itself (not through the wiki) and paste that link, it looks like https://xxx.feishu.cn/base/<app_token>?table=<table_id>", key)
		}
		parts := strings.Split(strings.Trim(u.Path, "/"), "/")
		if len(parts) != 2 || parts[0] != "base" {
			return nil, fmt.Errorf("sso: %s must look like https://xxx.feishu.cn/base/<app_token>?table=<table_id>", key)
		}
		ref = tableRef{App: parts[1], Table: u.Query().Get("table")}
	} else {
		app, table, _ := strings.Cut(v, "/")
		ref = tableRef{App: app, Table: table}
	}
	if !appTokenFormat.MatchString(ref.App) || !tableIDFormat.MatchString(ref.Table) {
		return nil, fmt.Errorf("sso: %s must be a base link with ?table=tbl… or <app_token>/<table_id>", key)
	}
	return &ref, nil
}

func randToken() string {
	b := make([]byte, 32)
	if _, err := rand.Read(b); err != nil {
		panic(err)
	}
	return base64.RawURLEncoding.EncodeToString(b)
}

func hashID(sid string) string {
	sum := sha256.Sum256([]byte(sid))
	return hex.EncodeToString(sum[:])
}

func txnCookieName(state string) string {
	if len(state) > 16 {
		state = state[:16]
	}
	return txnCookiePrefix + state
}

// safeNext 只接受本站路径，登录相关页面不算，和前端 safeNext 同一规则。
func safeNext(next string) string {
	if !strings.HasPrefix(next, "/") || strings.HasPrefix(next, "//") || strings.HasPrefix(next, "/\\") || strings.ContainsFunc(next, func(r rune) bool { return r < 0x20 || r == 0x7f }) {
		return ""
	}
	for _, p := range []string{"/login", "/auth"} {
		if next == p || strings.HasPrefix(next, p+"/") || strings.HasPrefix(next, p+"?") || strings.HasPrefix(next, p+"#") {
			return ""
		}
	}
	return next
}

func setCookie(w http.ResponseWriter, name, value string, ttl time.Duration) {
	maxAge := int(ttl.Seconds())
	if ttl < 0 {
		maxAge = -1
	}
	http.SetCookie(w, &http.Cookie{Name: name, Value: value, Path: "/", MaxAge: maxAge, HttpOnly: true, Secure: true, SameSite: http.SameSiteLaxMode})
}

func writeJSON(w http.ResponseWriter, status int, v any) {
	w.Header().Set("Content-Type", "application/json; charset=utf-8")
	w.Header().Set("Cache-Control", "no-store")
	w.WriteHeader(status)
	json.NewEncoder(w).Encode(v)
}

// ---------- 单实例文件存储 ----------

// FileStore 把会话和名单存在一个 JSON 文件里；每次改动先写盘，写盘失败就撤回内存里的改动。
// shortcut: 只适合单实例部署，多实例或已有数据库时用项目的库实现 Store。
type FileStore struct {
	path string
	mu   sync.Mutex
	data struct {
		Sessions  map[string]Session `json:"sessions"`
		Blocklist Blocklist          `json:"blocklist"`
	}
}

func NewFileStore(path string) (*FileStore, error) {
	fs := &FileStore{path: path}
	raw, err := os.ReadFile(path)
	if err != nil && !errors.Is(err, os.ErrNotExist) {
		return nil, err
	}
	if err == nil {
		if err := json.Unmarshal(raw, &fs.data); err != nil {
			return nil, fmt.Errorf("sso: %s: %w", path, err)
		}
	}
	if fs.data.Sessions == nil {
		fs.data.Sessions = map[string]Session{}
	}
	if fs.data.Blocklist.Entries == nil {
		fs.data.Blocklist.Entries = map[string]BlockEntry{}
	}
	return fs, nil
}

func (fs *FileStore) commit(undo func()) error {
	raw, err := json.MarshalIndent(fs.data, "", "  ")
	if err == nil {
		tmp := fs.path + ".tmp"
		if err = os.WriteFile(tmp, raw, 0o600); err == nil {
			err = os.Rename(tmp, fs.path)
		}
	}
	if err != nil {
		undo()
	}
	return err
}

func (fs *FileStore) CreateSession(_ context.Context, s Session) error {
	fs.mu.Lock()
	defer fs.mu.Unlock()
	fs.data.Sessions[s.IDHash] = s
	return fs.commit(func() { delete(fs.data.Sessions, s.IDHash) })
}

func (fs *FileStore) GetSession(_ context.Context, idHash string) (*Session, error) {
	fs.mu.Lock()
	defer fs.mu.Unlock()
	s, ok := fs.data.Sessions[idHash]
	if !ok {
		return nil, nil
	}
	return &s, nil
}

func (fs *FileStore) UpdateSession(_ context.Context, s Session, expectVersion int64) error {
	fs.mu.Lock()
	defer fs.mu.Unlock()
	cur, ok := fs.data.Sessions[s.IDHash]
	if !ok || cur.Version != expectVersion {
		return ErrConflict
	}
	s.Version = expectVersion + 1
	fs.data.Sessions[s.IDHash] = s
	return fs.commit(func() { fs.data.Sessions[s.IDHash] = cur })
}

func (fs *FileStore) DeleteSession(_ context.Context, idHash string) (*Session, error) {
	fs.mu.Lock()
	defer fs.mu.Unlock()
	s, ok := fs.data.Sessions[idHash]
	if !ok {
		return nil, nil
	}
	delete(fs.data.Sessions, idHash)
	if err := fs.commit(func() { fs.data.Sessions[idHash] = s }); err != nil {
		return nil, err
	}
	return &s, nil
}

func (fs *FileStore) AccountSessions(_ context.Context) ([]Session, error) {
	fs.mu.Lock()
	defer fs.mu.Unlock()
	var out []Session
	for _, s := range fs.data.Sessions {
		if s.Account {
			out = append(out, s)
		}
	}
	return out, nil
}

func (fs *FileStore) DeleteSessionsBySub(_ context.Context, subs map[string]BlockEntry) ([]Session, error) {
	fs.mu.Lock()
	defer fs.mu.Unlock()
	var gone []Session
	for id, s := range fs.data.Sessions {
		if _, ok := subs[s.Identity.Sub]; ok && !s.Account {
			gone = append(gone, s)
			delete(fs.data.Sessions, id)
		}
	}
	if len(gone) == 0 {
		return nil, nil
	}
	if err := fs.commit(func() {
		for _, s := range gone {
			fs.data.Sessions[s.IDHash] = s
		}
	}); err != nil {
		return nil, err
	}
	return gone, nil
}

func (fs *FileStore) BlocklistRevision(_ context.Context) (int64, bool, error) {
	fs.mu.Lock()
	defer fs.mu.Unlock()
	return fs.data.Blocklist.Revision, !fs.data.Blocklist.SyncedAt.IsZero(), nil
}

func (fs *FileStore) BlockedEntry(_ context.Context, sub string) (*BlockEntry, error) {
	fs.mu.Lock()
	defer fs.mu.Unlock()
	e, ok := fs.data.Blocklist.Entries[sub]
	if !ok {
		return nil, nil
	}
	return &e, nil
}

func (fs *FileStore) SaveBlocklist(_ context.Context, b Blocklist) error {
	fs.mu.Lock()
	defer fs.mu.Unlock()
	prev := fs.data.Blocklist
	if !prev.SyncedAt.IsZero() && b.Revision < prev.Revision {
		return ErrStaleBlocklist
	}
	fs.data.Blocklist = b
	return fs.commit(func() { fs.data.Blocklist = prev })
}

// ---------- 飞书多维表格 ----------

// bitable 用自建应用（tenant_access_token）读写多维表格。应用要开多维表格权限，并被加为这个多维表格的「可编辑」协作者。
type bitable struct {
	api, appID, appSecret string

	mu       sync.Mutex // 同一时刻只换一次 token
	token    string
	tokenExp time.Time
}

type record struct {
	ID     string         `json:"record_id"`
	Fields map[string]any `json:"fields"`
}

type tableField struct {
	Name string `json:"field_name"`
	Type int    `json:"type"`
}

type feishuError struct {
	Code int
	Msg  string
}

func (e *feishuError) Error() string { return fmt.Sprintf("feishu code %d %s", e.Code, e.Msg) }

// 1254043 RecordIdNotFound：那一行被删了。
var errRecordNotFound = errors.New("sso: record not found")

func (b *bitable) accessToken(ctx context.Context) (string, error) {
	b.mu.Lock()
	defer b.mu.Unlock()
	if b.token != "" && time.Now().Before(b.tokenExp) {
		return b.token, nil
	}
	var out struct {
		Code   *int   `json:"code"`
		Msg    string `json:"msg"`
		Token  string `json:"tenant_access_token"`
		Expire int    `json:"expire"`
	}
	body, _ := json.Marshal(map[string]string{"app_id": b.appID, "app_secret": b.appSecret})
	if err := b.do(ctx, http.MethodPost, "/open-apis/auth/v3/tenant_access_token/internal", "", body, &out); err != nil {
		return "", err
	}
	if out.Code == nil || *out.Code != 0 || out.Token == "" {
		return "", fmt.Errorf("feishu tenant_access_token code %v %s", out.Code, out.Msg)
	}
	// 提前 5 分钟换新的。
	b.token, b.tokenExp = out.Token, time.Now().Add(time.Duration(out.Expire)*time.Second-5*time.Minute)
	return b.token, nil
}

func (b *bitable) do(ctx context.Context, method, path, token string, body []byte, out any) error {
	ctx, cancel := context.WithTimeout(ctx, feishuTimeout)
	defer cancel()
	req, _ := http.NewRequestWithContext(ctx, method, b.api+path, bytes.NewReader(body))
	req.Header.Set("Content-Type", "application/json; charset=utf-8")
	if token != "" {
		req.Header.Set("Authorization", "Bearer "+token)
	}
	resp, err := http.DefaultClient.Do(req)
	if err != nil {
		return err
	}
	defer resp.Body.Close()
	raw, _ := io.ReadAll(io.LimitReader(resp.Body, 8<<20))
	if err := json.Unmarshal(raw, out); err != nil {
		return fmt.Errorf("feishu HTTP %d, body not JSON", resp.StatusCode)
	}
	return nil
}

// call 调一个多维表格接口，code 不是 0 算错；token 失效换一次再试。
func (b *bitable) call(ctx context.Context, method, path string, body any, data any) error {
	var raw []byte
	if body != nil {
		raw, _ = json.Marshal(body)
	}
	for attempt := 0; ; attempt++ {
		token, err := b.accessToken(ctx)
		if err != nil {
			return err
		}
		var env struct {
			Code *int            `json:"code"`
			Msg  string          `json:"msg"`
			Data json.RawMessage `json:"data"`
		}
		if err := b.do(ctx, method, path, token, raw, &env); err != nil {
			return err
		}
		if env.Code == nil {
			return errors.New("feishu response without code")
		}
		if (*env.Code == 99991663 || *env.Code == 99991661 || *env.Code == 99991668) && attempt == 0 {
			b.mu.Lock()
			b.token = ""
			b.mu.Unlock()
			continue
		}
		if *env.Code == 1254043 {
			return errRecordNotFound
		}
		if *env.Code != 0 {
			return &feishuError{Code: *env.Code, Msg: env.Msg}
		}
		if data != nil && len(env.Data) > 0 {
			return json.Unmarshal(env.Data, data)
		}
		return nil
	}
}

func (t tableRef) path(suffix string) string {
	return "/open-apis/bitable/v1/apps/" + url.PathEscape(t.App) + "/tables/" + url.PathEscape(t.Table) + suffix
}

// search 翻页取完（最多 maxPages 页，每页 500 行）；filter、sort 为 nil 是整表、不排序。
func (b *bitable) search(ctx context.Context, t tableRef, filter, sort any, maxPages int) ([]record, error) {
	var all []record
	pageToken := ""
	for page := 0; page < maxPages; page++ {
		data, err := b.searchCall(ctx, t, filter, sort, 500, pageToken)
		if err != nil {
			return nil, err
		}
		all = append(all, data.Items...)
		if !data.HasMore || data.PageToken == "" {
			return all, nil
		}
		pageToken = data.PageToken
	}
	return nil, fmt.Errorf("feishu search: more than %d pages", maxPages)
}

// searchPage 只取第一页。
func (b *bitable) searchPage(ctx context.Context, t tableRef, filter, sort any, size int) ([]record, error) {
	data, err := b.searchCall(ctx, t, filter, sort, size, "")
	return data.Items, err
}

// count 用 page_size=1 的查询读总行数。
func (b *bitable) count(ctx context.Context, t tableRef, filter any) (int, error) {
	data, err := b.searchCall(ctx, t, filter, nil, 1, "")
	return data.Total, err
}

type searchData struct {
	Items     []record `json:"items"`
	HasMore   bool     `json:"has_more"`
	PageToken string   `json:"page_token"`
	Total     int      `json:"total"`
}

func (b *bitable) searchCall(ctx context.Context, t tableRef, filter, sort any, size int, pageToken string) (searchData, error) {
	body := map[string]any{}
	if filter != nil {
		body["filter"] = filter
	}
	if sort != nil {
		body["sort"] = sort
	}
	q := url.Values{"page_size": {strconv.Itoa(size)}}
	if pageToken != "" {
		q.Set("page_token", pageToken)
	}
	var data searchData
	err := b.call(ctx, http.MethodPost, t.path("/records/search?"+q.Encode()), body, &data)
	return data, err
}

func (b *bitable) batchDelete(ctx context.Context, t tableRef, ids []string) error {
	return b.call(ctx, http.MethodPost, t.path("/records/batch_delete"), map[string]any{"records": ids}, nil)
}

func (b *bitable) get(ctx context.Context, t tableRef, recordID string) (record, error) {
	var data struct {
		Record record `json:"record"`
	}
	err := b.call(ctx, http.MethodGet, t.path("/records/"+url.PathEscape(recordID)), nil, &data)
	return data.Record, err
}

func (b *bitable) batchUpdate(ctx context.Context, t tableRef, recs []record) error {
	return b.call(ctx, http.MethodPost, t.path("/records/batch_update"), map[string]any{"records": recs}, nil)
}

func (b *bitable) batchCreate(ctx context.Context, t tableRef, rows []map[string]any) error {
	recs := make([]map[string]any, len(rows))
	for i, f := range rows {
		recs[i] = map[string]any{"fields": f}
	}
	return b.call(ctx, http.MethodPost, t.path("/records/batch_create"), map[string]any{"records": recs}, nil)
}

func (b *bitable) fields(ctx context.Context, t tableRef) ([]tableField, error) {
	var all []tableField
	pageToken := ""
	for page := 0; page < 20; page++ {
		q := url.Values{"page_size": {"100"}}
		if pageToken != "" {
			q.Set("page_token", pageToken)
		}
		var data struct {
			Items     []tableField `json:"items"`
			HasMore   bool         `json:"has_more"`
			PageToken string       `json:"page_token"`
		}
		if err := b.call(ctx, http.MethodGet, t.path("/fields?"+q.Encode()), nil, &data); err != nil {
			return nil, err
		}
		all = append(all, data.Items...)
		if !data.HasMore || data.PageToken == "" {
			return all, nil
		}
		pageToken = data.PageToken
	}
	return nil, errors.New("feishu fields: too many pages")
}

// accountRow 是账号表的一行。Username、Password 保留原样（判断前后空格要用）。
type accountRow struct {
	ID           string
	Username     string
	Password     string
	Enabled      string // 账号状态
	Status, Note string // 状态、状态说明（系统写的）
	Remark       string // 备注
	Checked      map[string]bool
}

// blank 是整行人填的格子都空着（多维表格新建时自带的空行），不去写它。
func (r accountRow) blank() bool {
	return r.Username == "" && r.Password == "" && r.Enabled == "" && r.Remark == ""
}

// parseAccountRow 兼容两种格子写法：查询接口里文本是 [{"type":"text","text":"…"}] 分段（可能多段），
// 按 ID 取时是纯字符串；空格子在查询里不出现、按 ID 取时是 null。
func parseAccountRow(rec record) accountRow {
	row := accountRow{ID: rec.ID, Checked: map[string]bool{}}
	row.Username = cellText(rec.Fields[colUsername])
	row.Password = cellText(rec.Fields[colPassword])
	row.Enabled = cellText(rec.Fields[colEnabled])
	row.Status = cellText(rec.Fields[colStatus])
	row.Note = cellText(rec.Fields[colNote])
	row.Remark = cellText(rec.Fields["备注"])
	for k, v := range rec.Fields {
		if v == true {
			row.Checked[k] = true
		}
	}
	return row
}

func cellText(v any) string {
	switch x := v.(type) {
	case string:
		return x
	case []any:
		var b strings.Builder
		for _, seg := range x {
			switch s := seg.(type) {
			case string:
				b.WriteString(s)
			case map[string]any:
				if t, ok := s["text"].(string); ok {
					b.WriteString(t)
				}
			}
		}
		return b.String()
	case map[string]any:
		if t, ok := x["text"].(string); ok {
			return t
		}
	}
	return ""
}

// ---------- 待写队列 ----------

// outbox 是写日志表、写回账号表的持久队列：每次去写之前先 fsync 落盘，写成了才删；重启接着写。
// 登录和请求从不等它（落盘也在后台），写不进去只在健康检查里报。同一行的写回合并成一条（后写的值为准），
// 还没写出去的一样的请求日志合成一行（次数加一、耗时取最大）。
type outbox struct {
	path     string
	mu       sync.Mutex
	seq      int64
	items    []outboxItem
	inflight map[int64]bool
	wake     map[string]chan struct{}
	kick     map[string]chan struct{} // 兜底对账叫醒在退避里等着的写入
	dirty    chan struct{}
	saveErr  bool

	requestTimes []time.Time // 最近一分钟新增的请求日志行
	dropping     bool        // 正在丢请求日志（只在开始丢时记一行 stderr）
	dropped      int64
	droppedAt    time.Time
}

type outboxItem struct {
	ID       int64          `json:"id"`
	Target   string         `json:"target"` // "log"：日志表新增一行；"accounts"：账号表更新 RecordID 那一行
	RecordID string         `json:"record_id,omitempty"`
	Merge    string         `json:"merge,omitempty"`
	Fields   map[string]any `json:"fields"`
	At       time.Time      `json:"at"`
}

func openOutbox(path string, targets []string) (*outbox, error) {
	ob := &outbox{path: path, items: []outboxItem{}, inflight: map[int64]bool{}, wake: map[string]chan struct{}{}, kick: map[string]chan struct{}{}, dirty: make(chan struct{}, 1)}
	for _, t := range targets {
		ob.wake[t] = make(chan struct{}, 1)
		ob.kick[t] = make(chan struct{}, 1)
	}
	raw, err := os.ReadFile(path)
	if err != nil && !errors.Is(err, os.ErrNotExist) {
		return nil, fmt.Errorf("sso: SSO_OUTBOX_FILE: %w", err)
	}
	if len(raw) > 0 {
		var saved []outboxItem
		if json.Unmarshal(raw, &saved) != nil {
			// 文件坏了也不能挡登录：挪到一边留着查，从空队列开始。
			aside := path + ".corrupt-" + time.Now().Format("20060102T150405")
			os.Rename(path, aside)
			log.Printf("sso: outbox file unreadable, moved to %s", aside)
		}
		dropped := 0
		for _, it := range saved {
			if _, ok := ob.wake[it.Target]; !ok {
				dropped++
				continue
			}
			ob.items = append(ob.items, it)
			ob.seq = max(ob.seq, it.ID)
		}
		if dropped > 0 {
			log.Printf("sso: outbox dropped %d entries for a table that is no longer configured", dropped)
		}
	}
	if err := ob.save(); err != nil {
		return nil, fmt.Errorf("sso: SSO_OUTBOX_FILE: %w", err)
	}
	for _, t := range targets {
		ob.wake[t] <- struct{}{} // 重启前没写完的接着写
	}
	return ob, nil
}

func (ob *outbox) targets() []string { return slices.Sorted(maps.Keys(ob.wake)) }

// kickBacklog 让还有积压的写入不等退避、马上再写一次（兜底对账每轮调一次）。
func (ob *outbox) kickBacklog() {
	ob.mu.Lock()
	defer ob.mu.Unlock()
	for _, it := range ob.items {
		select {
		case ob.kick[it.Target] <- struct{}{}:
		default:
		}
	}
}

func (ob *outbox) add(it outboxItem) {
	ob.mu.Lock()
	defer ob.mu.Unlock()
	if !ob.merge(it) {
		if it.Merge != "" && !ob.allowRequestRow() {
			return
		}
		ob.seq++
		it.ID, it.At = ob.seq, time.Now()
		ob.items = append(ob.items, it)
		ob.trimLogs()
	}
	select {
	case ob.dirty <- struct{}{}:
	default:
	}
	select {
	case ob.wake[it.Target] <- struct{}{}:
	default:
	}
}

// merge 把这一条并进队列里还没写出去的同一条：账号表同一行后写的值为准；一样的请求日志次数加一、耗时取最大，时间留第一次的。
func (ob *outbox) merge(it outboxItem) bool {
	for i := range ob.items {
		e := &ob.items[i]
		if ob.inflight[e.ID] || e.Target != it.Target {
			continue
		}
		switch {
		case it.Target == targetAccounts && e.RecordID == it.RecordID:
			maps.Copy(e.Fields, it.Fields)
			return true
		case it.Merge != "" && e.Merge == it.Merge:
			e.Fields["次数"] = asInt(e.Fields["次数"]) + 1
			e.Fields["耗时毫秒"] = max(asInt(e.Fields["耗时毫秒"]), asInt(it.Fields["耗时毫秒"]))
			return true
		}
	}
	return false
}

// allowRequestRow 最近一分钟新增的请求日志行到了 200 就丢，开始丢时记一行 stderr，健康检查里看得到丢了多少。
func (ob *outbox) allowRequestRow() bool {
	now := time.Now()
	ob.requestTimes = slices.DeleteFunc(ob.requestTimes, func(t time.Time) bool { return now.Sub(t) > time.Minute })
	if len(ob.requestTimes) < requestRowsPerMinute {
		ob.requestTimes = append(ob.requestTimes, now)
		ob.dropping = false
		return true
	}
	if !ob.dropping {
		log.Printf("sso: more than %d request log rows in a minute, dropping the rest", requestRowsPerMinute)
		ob.dropping = true
	}
	ob.dropped++
	ob.droppedAt = now
	return false
}

func asInt(v any) int64 {
	switch n := v.(type) {
	case int:
		return int64(n)
	case int64:
		return n
	case float64:
		return int64(n)
	}
	return 0
}

// trimLogs 日志超过上限时丢最旧的（正在写的不丢），并记 stderr。
func (ob *outbox) trimLogs() {
	n := 0
	for _, it := range ob.items {
		if it.Target == targetLog {
			n++
		}
	}
	drop := n - outboxMaxLogs
	if drop <= 0 {
		return
	}
	dropped := 0
	ob.items = slices.DeleteFunc(ob.items, func(it outboxItem) bool {
		if dropped < drop && it.Target == targetLog && !ob.inflight[it.ID] {
			dropped++
			return true
		}
		return false
	})
	log.Printf("sso: outbox over %d log rows, dropped the %d oldest", outboxMaxLogs, dropped)
}

// saveLoop 有改动就在后台落盘，登录和请求不用等 fsync。
func (ob *outbox) saveLoop() {
	for range ob.dirty {
		ob.mu.Lock()
		ob.saveLogged()
		ob.mu.Unlock()
	}
}

// saveLogged 落盘，只在刚开始失败时记一行 stderr。调用方持有 mu。
func (ob *outbox) saveLogged() {
	failedBefore := ob.saveErr
	if err := ob.save(); err != nil && !failedBefore {
		log.Printf("sso: outbox write failed (kept in memory): %v", err)
	}
}

func (ob *outbox) save() error {
	raw, _ := json.Marshal(ob.items)
	tmp := ob.path + ".tmp"
	f, err := os.OpenFile(tmp, os.O_WRONLY|os.O_CREATE|os.O_TRUNC, 0o600)
	if err == nil {
		_, err = f.Write(raw)
		if err == nil {
			err = f.Sync()
		}
		if cerr := f.Close(); err == nil {
			err = cerr
		}
	}
	if err == nil {
		err = os.Rename(tmp, ob.path)
	}
	ob.saveErr = err != nil
	return err
}

// take 取一批（最多 500 条）去写，取之前先落盘：写出去之前一定已经在盘上。
func (ob *outbox) take(target string) []outboxItem {
	ob.mu.Lock()
	defer ob.mu.Unlock()
	var batch []outboxItem
	for _, it := range ob.items {
		if it.Target == target && !ob.inflight[it.ID] {
			ob.inflight[it.ID] = true
			batch = append(batch, outboxItem{ID: it.ID, Target: it.Target, RecordID: it.RecordID, Merge: it.Merge, Fields: maps.Clone(it.Fields), At: it.At})
			if len(batch) == outboxBatch {
				break
			}
		}
	}
	if len(batch) > 0 {
		ob.saveLogged()
	}
	return batch
}

func (ob *outbox) finish(batch []outboxItem, delivered bool) {
	ob.mu.Lock()
	defer ob.mu.Unlock()
	done := map[int64]bool{}
	for _, it := range batch {
		delete(ob.inflight, it.ID)
		done[it.ID] = true
	}
	if !delivered {
		return
	}
	ob.items = slices.DeleteFunc(ob.items, func(it outboxItem) bool { return done[it.ID] })
	ob.saveLogged()
}

type outboxStats struct {
	pending    int
	oldest     time.Time
	saveFailed bool
	dropped    int64
	droppedAt  time.Time
}

func (ob *outbox) stats() outboxStats {
	ob.mu.Lock()
	defer ob.mu.Unlock()
	st := outboxStats{pending: len(ob.items), saveFailed: ob.saveErr, dropped: ob.dropped, droppedAt: ob.droppedAt}
	for _, it := range ob.items {
		if st.oldest.IsZero() || it.At.Before(st.oldest) {
			st.oldest = it.At
		}
	}
	return st
}

// outboxWorker 一张表一个，互不耽误：有东西进来就写，写的时候新进来的攒着下一次一起写；
// 失败才按 1 秒起翻倍、最长 5 分钟退避重试（日志表写满了也一样，登录和请求照常）。
// 日志表每写 500 行查一次总行数，超了按上限删最旧的请求日志；启动时也查一次。
func (s *SSO) outboxWorker(target string) {
	backoff := time.Second
	written := 0
	if target == targetLog {
		s.trimLogTable()
	}
	for {
		batch := s.outbox.take(target)
		if len(batch) == 0 {
			<-s.outbox.wake[target]
			continue
		}
		ctx, cancel := context.WithTimeout(context.Background(), upstreamLimit)
		err := s.deliver(ctx, target, batch)
		cancel()
		s.outbox.finish(batch, err == nil)
		if err != nil {
			log.Printf("sso: outbox %s: %d not written, retry in %s: %v", target, len(batch), backoff, err)
			// 写不进去可能是有人改了列：顺手查一次表结构，健康检查报得出是哪一列。
			ctx, cancel := context.WithTimeout(context.Background(), upstreamLimit)
			s.checkSchema(ctx)
			cancel()
			select {
			case <-time.After(backoff):
			case <-s.outbox.kick[target]:
			}
			backoff = min(backoff*2, outboxMaxBackoff)
			continue
		}
		backoff = time.Second
		if target == targetLog {
			if written += len(batch); written >= logTrimEvery {
				written = 0
				s.trimLogTable()
			}
		}
	}
}

func (s *SSO) deliver(ctx context.Context, target string, batch []outboxItem) error {
	if target == targetLog {
		rows := make([]map[string]any, len(batch))
		for i, it := range batch {
			rows[i] = it.Fields
		}
		return s.feishu.batchCreate(ctx, *s.logTable, rows)
	}
	recs := make([]record, len(batch))
	for i, it := range batch {
		recs[i] = record{ID: it.RecordID, Fields: it.Fields}
	}
	err := s.feishu.batchUpdate(ctx, *s.accountsTable, recs)
	if !errors.Is(err, errRecordNotFound) {
		return err
	}
	// 有一行已被人删了：逐行写，删掉的那行就不用写了。
	for _, rec := range recs {
		if err := s.feishu.batchUpdate(ctx, *s.accountsTable, []record{rec}); err != nil && !errors.Is(err, errRecordNotFound) {
			return err
		}
	}
	return nil
}

// trimLogTable 日志表总行数超过 SSO_LOG_MAX_ROWS 时，删最旧的「请求」行（不分项目，日志表是共用的），删到上限的 90%；
// 登录、退出、被收回的行永远不删。失败只记 stderr，下次再说。
func (s *SSO) trimLogTable() {
	ctx, cancel := context.WithTimeout(context.Background(), time.Minute)
	defer cancel()
	total, err := s.feishu.count(ctx, *s.logTable, nil)
	if err != nil {
		log.Printf("sso: log table count: %v", err)
		return
	}
	if total <= s.logMaxRows {
		return
	}
	target := s.logMaxRows * 9 / 10
	onlyRequests := map[string]any{"conjunction": "and", "conditions": []any{
		map[string]any{"field_name": "类型", "operator": "is", "value": []string{typeRequest}},
	}}
	oldestFirst := []any{map[string]any{"field_name": "时间", "desc": false}}
	deleted := 0
	for total > target {
		recs, err := s.feishu.searchPage(ctx, *s.logTable, onlyRequests, oldestFirst, min(outboxBatch, total-target))
		if err != nil || len(recs) == 0 {
			if err != nil {
				log.Printf("sso: log table trim: %v", err)
			}
			break
		}
		ids := make([]string, len(recs))
		for i, rec := range recs {
			ids[i] = rec.ID
		}
		if err := s.feishu.batchDelete(ctx, *s.logTable, ids); err != nil {
			log.Printf("sso: log table trim: %v", err)
			break
		}
		total -= len(ids)
		deleted += len(ids)
	}
	log.Printf("sso: log table over %d rows, deleted the %d oldest request rows", s.logMaxRows, deleted)
}
