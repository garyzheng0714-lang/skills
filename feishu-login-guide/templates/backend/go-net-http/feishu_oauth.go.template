// Package auth - 飞书登录处理（FBIF + 富的 双企业 App，net/http 版本）
//
// 占位符替换：
//   {{FBIF_APP_ID}}   → FBIF 主企业飞书 App ID（cli_xxx），从密钥仓库读
//   {{FUDE_APP_ID}}   → 富的 App ID，从密钥仓库读
//
// 所有 App ID / Secret 都从密钥仓库（~/Library/Mobile Documents/com~apple~CloudDocs/
// 密钥/FBIF登录应用APPid和密钥/feishu-app-credentials.md）取，绝不在代码里 fallback。
//
// 使用：
//   import "<your-module>/internal/auth"
//   mux.Handle("/auth/feishu/", auth.NewFeishuHandler())
//
// 环境变量（全部必填，缺则启动时报错）：
//   FEISHU_FBIF_APP_SECRET   FBIF App Secret
//   FEISHU_FUDE_APP_SECRET   富的 App Secret
//   FEISHU_REDIRECT_BASE     部署 URL，不带路径（绝对不能是 http://localhost:...）
//   FEISHU_ALLOWED_TENANT_KEYS  选填，逗号分隔白名单
//
// 路由：
//   GET  /auth/feishu/fbif/login        FBIF 按钮模式
//   GET  /auth/feishu/fbif/callback     FBIF 按钮回调（v2 token 流程）
//   GET  /auth/feishu/fbif/qr-config    FBIF 扫码模式配置
//   GET  /auth/feishu/fbif/qr-callback  FBIF 扫码回调（v1 token 流程）
//   GET  /auth/feishu/fude/...          富的 4 条同上
//   POST /auth/feishu/logout            退出登录（共享）

package auth

import (
	"bytes"
	"crypto/rand"
	"encoding/base64"
	"encoding/json"
	"fmt"
	"io"
	"log"
	"net/http"
	"net/url"
	"os"
	"strings"
	"time"
)

// ========== 双 App 配置 ==========

const (
	// FBIF 主企业 App ID（替换占位符；App ID 不是机密，但 Secret 严禁写死）
	fbifAppID = "{{FBIF_APP_ID}}"

	// 富的文化传媒（上海）有限公司 App（v3 起跨项目共享）
	fudeAppID = "{{FUDE_APP_ID}}"

	// 按钮模式（v2，accounts.feishu.cn）
	feishuAuthorizeURL = "https://accounts.feishu.cn/open-apis/authen/v1/authorize"
	feishuTokenV2URL   = "https://open.feishu.cn/open-apis/authen/v2/oauth/token"

	// 扫码模式（v1，passport.feishu.cn）—— 飞书 QR SDK 仅支持此端点
	feishuQRAuthorizeURL = "https://passport.feishu.cn/suite/passport/oauth/authorize"
	feishuAppTokenURL    = "https://open.feishu.cn/open-apis/auth/v3/app_access_token/internal"
	feishuTokenV1URL     = "https://open.feishu.cn/open-apis/authen/v1/access_token"

	// 共用
	feishuUserInfoURL = "https://open.feishu.cn/open-apis/authen/v1/user_info"

	stateCookieTTL = 10 * time.Minute
)

type tenant string

const (
	tenantFBIF tenant = "fbif"
	tenantFUDE tenant = "fude"
)

var allTenants = []tenant{tenantFBIF, tenantFUDE}

type tenantConfig struct {
	appID     string
	secretEnv string
}

func cfgFor(t tenant) tenantConfig {
	switch t {
	case tenantFBIF:
		return tenantConfig{appID: fbifAppID, secretEnv: "FEISHU_FBIF_APP_SECRET"}
	case tenantFUDE:
		return tenantConfig{appID: fudeAppID, secretEnv: "FEISHU_FUDE_APP_SECRET"}
	}
	return tenantConfig{}
}

func (cfg tenantConfig) secret() (string, error) {
	if v := os.Getenv(cfg.secretEnv); v != "" {
		return v, nil
	}
	// 不允许任何 fallback：缺 env 立刻失败，定位清楚
	return "", fmt.Errorf(
		"%s not set. Read it from the credentials vault: "+
			"~/Library/Mobile Documents/com~apple~CloudDocs/密钥/FBIF登录应用APPid和密钥/",
		cfg.secretEnv,
	)
}

func redirectBase() string {
	base := os.Getenv("FEISHU_REDIRECT_BASE")
	if base == "" {
		base = "http://localhost:8080"
	}
	return strings.TrimRight(base, "/")
}

func callbackURI(t tenant) string {
	return fmt.Sprintf("%s/auth/feishu/%s/callback", redirectBase(), t)
}

func qrCallbackURI(t tenant) string {
	return fmt.Sprintf("%s/auth/feishu/%s/qr-callback", redirectBase(), t)
}

func stateCookieName(t tenant, mode string) string {
	return fmt.Sprintf("feishu_state_%s_%s", t, mode)
}

// ========== 类型 ==========

type FeishuUser struct {
	OpenID    string `json:"open_id"`
	UnionID   string `json:"union_id"`
	UserID    string `json:"user_id"`
	Name      string `json:"name"`
	EnName    string `json:"en_name"`
	AvatarURL string `json:"avatar_url"`
	Email     string `json:"email"`
	Mobile    string `json:"mobile"`
	TenantKey string `json:"tenant_key"`
}

// ========== 路由 ==========

func NewFeishuHandler() http.Handler {
	mux := http.NewServeMux()
	for _, t := range allTenants {
		tn := t
		mux.HandleFunc(fmt.Sprintf("/auth/feishu/%s/login", tn), func(w http.ResponseWriter, r *http.Request) {
			handleLogin(w, r, tn)
		})
		mux.HandleFunc(fmt.Sprintf("/auth/feishu/%s/callback", tn), func(w http.ResponseWriter, r *http.Request) {
			handleCallback(w, r, tn)
		})
		mux.HandleFunc(fmt.Sprintf("/auth/feishu/%s/qr-config", tn), func(w http.ResponseWriter, r *http.Request) {
			handleQRConfig(w, r, tn)
		})
		mux.HandleFunc(fmt.Sprintf("/auth/feishu/%s/qr-callback", tn), func(w http.ResponseWriter, r *http.Request) {
			handleQRCallback(w, r, tn)
		})
	}
	mux.HandleFunc("/auth/feishu/logout", handleLogout)
	return mux
}

// ========== 按钮模式（v2） ==========

func handleLogin(w http.ResponseWriter, r *http.Request, t tenant) {
	state, err := randomState(24)
	if err != nil {
		http.Error(w, "internal error", http.StatusInternalServerError)
		return
	}
	setStateCookie(w, r, stateCookieName(t, "oauth"), state)

	cfg := cfgFor(t)
	q := url.Values{}
	q.Set("client_id", cfg.appID)
	q.Set("redirect_uri", callbackURI(t))
	q.Set("response_type", "code")
	q.Set("state", state)

	http.Redirect(w, r, feishuAuthorizeURL+"?"+q.Encode(), http.StatusFound)
}

func handleCallback(w http.ResponseWriter, r *http.Request, t tenant) {
	if !verifyAndClearStateCookie(w, r, stateCookieName(t, "oauth")) {
		http.Error(w, "state mismatch", http.StatusForbidden)
		return
	}
	if errParam := r.URL.Query().Get("error"); errParam != "" {
		log.Printf("feishu authorize denied (%s): %s - %s", t, errParam, r.URL.Query().Get("error_description"))
		http.Redirect(w, r, "/login?error=denied", http.StatusFound)
		return
	}
	code := r.URL.Query().Get("code")
	if code == "" {
		http.Error(w, "missing code", http.StatusBadRequest)
		return
	}

	token, err := exchangeCodeV2(t, code)
	if err != nil {
		log.Printf("token v2 exchange (%s): %v", t, err)
		http.Error(w, "token exchange failed", http.StatusInternalServerError)
		return
	}
	finishLogin(w, r, t, token)
}

// ========== 扫码模式（v1） ==========

func handleQRConfig(w http.ResponseWriter, r *http.Request, t tenant) {
	state, err := randomState(24)
	if err != nil {
		http.Error(w, "internal error", http.StatusInternalServerError)
		return
	}
	setStateCookie(w, r, stateCookieName(t, "qr"), state)

	cfg := cfgFor(t)
	q := url.Values{}
	q.Set("client_id", cfg.appID)
	q.Set("redirect_uri", qrCallbackURI(t))
	q.Set("response_type", "code")
	q.Set("state", state)

	resp := map[string]interface{}{
		"goto":       feishuQRAuthorizeURL + "?" + q.Encode(),
		"state":      state,
		"expires_in": 300,
	}
	w.Header().Set("Content-Type", "application/json; charset=utf-8")
	w.Header().Set("Cache-Control", "no-store")
	json.NewEncoder(w).Encode(resp)
}

func handleQRCallback(w http.ResponseWriter, r *http.Request, t tenant) {
	if !verifyAndClearStateCookie(w, r, stateCookieName(t, "qr")) {
		http.Error(w, "state mismatch", http.StatusForbidden)
		return
	}
	if errParam := r.URL.Query().Get("error"); errParam != "" {
		log.Printf("feishu QR authorize denied (%s): %s - %s", t, errParam, r.URL.Query().Get("error_description"))
		http.Redirect(w, r, "/login?error=denied", http.StatusFound)
		return
	}
	code := r.URL.Query().Get("code")
	if code == "" {
		http.Error(w, "missing code", http.StatusBadRequest)
		return
	}

	appToken, err := getAppAccessToken(t)
	if err != nil {
		log.Printf("get app_access_token (%s): %v", t, err)
		http.Redirect(w, r, "/login?error=app_token_failed", http.StatusFound)
		return
	}
	token, err := exchangeCodeV1(code, appToken)
	if err != nil {
		log.Printf("token v1 exchange (%s): %v", t, err)
		http.Error(w, "token exchange failed", http.StatusInternalServerError)
		return
	}
	finishLogin(w, r, t, token)
}

// ========== Logout（共享） ==========

func handleLogout(w http.ResponseWriter, r *http.Request) {
	// TODO: 调用项目现有 session 清理逻辑（清 cookie + 删服务端 session）
	w.WriteHeader(http.StatusNoContent)
}

// ========== 共用：拿用户、白名单、建会话 ==========

func finishLogin(w http.ResponseWriter, r *http.Request, t tenant, userToken string) {
	user, err := fetchUserInfo(userToken)
	if err != nil {
		log.Printf("fetch user_info (%s): %v", t, err)
		http.Error(w, "fetch user info failed", http.StatusInternalServerError)
		return
	}
	log.Printf("[auth] login ok via %s tenant_key=%s open_id=%s name=%s",
		t, user.TenantKey, user.OpenID, user.Name)
	if !isAllowedTenant(user.TenantKey) {
		log.Printf("login denied: tenant_key %q not in FEISHU_ALLOWED_TENANT_KEYS", user.TenantKey)
		http.Redirect(w, r, "/login?error=unauthorized_tenant", http.StatusFound)
		return
	}
	localID, err := upsertLocalUser(user)
	if err != nil {
		http.Error(w, "internal error", http.StatusInternalServerError)
		return
	}
	createSession(w, localID)
	http.Redirect(w, r, "/", http.StatusFound)
}

// ========== Token 兑换 ==========

// v2 流程
func exchangeCodeV2(t tenant, code string) (string, error) {
	cfg := cfgFor(t)
	secret, err := cfg.secret()
	if err != nil {
		return "", err
	}
	body, _ := json.Marshal(map[string]string{
		"grant_type":    "authorization_code",
		"client_id":     cfg.appID,
		"client_secret": secret,
		"code":          code,
		"redirect_uri":  callbackURI(t),
	})
	req, _ := http.NewRequest(http.MethodPost, feishuTokenV2URL, bytes.NewReader(body))
	req.Header.Set("Content-Type", "application/json; charset=utf-8")
	resp, err := http.DefaultClient.Do(req)
	if err != nil {
		return "", err
	}
	defer resp.Body.Close()
	raw, _ := io.ReadAll(resp.Body)
	var r struct {
		Code        int    `json:"code"`
		AccessToken string `json:"access_token"`
		ErrorDesc   string `json:"error_description"`
	}
	if err := json.Unmarshal(raw, &r); err != nil {
		return "", fmt.Errorf("decode v2 token resp: %w", err)
	}
	if r.Code != 0 || r.AccessToken == "" {
		return "", fmt.Errorf("v2 token api code=%d desc=%s", r.Code, r.ErrorDesc)
	}
	return r.AccessToken, nil
}

// v1 流程第一步
func getAppAccessToken(t tenant) (string, error) {
	cfg := cfgFor(t)
	secret, err := cfg.secret()
	if err != nil {
		return "", err
	}
	body, _ := json.Marshal(map[string]string{
		"app_id":     cfg.appID,
		"app_secret": secret,
	})
	req, _ := http.NewRequest(http.MethodPost, feishuAppTokenURL, bytes.NewReader(body))
	req.Header.Set("Content-Type", "application/json; charset=utf-8")
	resp, err := http.DefaultClient.Do(req)
	if err != nil {
		return "", err
	}
	defer resp.Body.Close()
	raw, _ := io.ReadAll(resp.Body)
	var r struct {
		Code           int    `json:"code"`
		Msg            string `json:"msg"`
		AppAccessToken string `json:"app_access_token"`
	}
	if err := json.Unmarshal(raw, &r); err != nil {
		return "", fmt.Errorf("decode app_token resp: %w", err)
	}
	if r.Code != 0 || r.AppAccessToken == "" {
		return "", fmt.Errorf("app_token api code=%d msg=%s", r.Code, r.Msg)
	}
	return r.AppAccessToken, nil
}

// v1 流程第二步
func exchangeCodeV1(code, appAccessToken string) (string, error) {
	body, _ := json.Marshal(map[string]string{
		"grant_type": "authorization_code",
		"code":       code,
	})
	req, _ := http.NewRequest(http.MethodPost, feishuTokenV1URL, bytes.NewReader(body))
	req.Header.Set("Content-Type", "application/json; charset=utf-8")
	req.Header.Set("Authorization", "Bearer "+appAccessToken)
	resp, err := http.DefaultClient.Do(req)
	if err != nil {
		return "", err
	}
	defer resp.Body.Close()
	raw, _ := io.ReadAll(resp.Body)
	var r struct {
		Code int    `json:"code"`
		Msg  string `json:"msg"`
		Data struct {
			AccessToken string `json:"access_token"`
		} `json:"data"`
	}
	if err := json.Unmarshal(raw, &r); err != nil {
		return "", fmt.Errorf("decode v1 token resp: %w", err)
	}
	if r.Code != 0 || r.Data.AccessToken == "" {
		return "", fmt.Errorf("v1 token api code=%d msg=%s", r.Code, r.Msg)
	}
	return r.Data.AccessToken, nil
}

func fetchUserInfo(token string) (*FeishuUser, error) {
	req, _ := http.NewRequest(http.MethodGet, feishuUserInfoURL, nil)
	req.Header.Set("Authorization", "Bearer "+token)
	resp, err := http.DefaultClient.Do(req)
	if err != nil {
		return nil, err
	}
	defer resp.Body.Close()
	var r struct {
		Code int        `json:"code"`
		Msg  string     `json:"msg"`
		Data FeishuUser `json:"data"`
	}
	if err := json.NewDecoder(resp.Body).Decode(&r); err != nil {
		return nil, err
	}
	if r.Code != 0 {
		return nil, fmt.Errorf("user_info api code=%d msg=%s", r.Code, r.Msg)
	}
	return &r.Data, nil
}

// ========== 工具 ==========

func setStateCookie(w http.ResponseWriter, r *http.Request, name, value string) {
	http.SetCookie(w, &http.Cookie{
		Name:     name,
		Value:    value,
		Path:     "/auth/feishu/",
		HttpOnly: true,
		Secure:   r.TLS != nil,
		SameSite: http.SameSiteLaxMode,
		MaxAge:   int(stateCookieTTL.Seconds()),
	})
}

func verifyAndClearStateCookie(w http.ResponseWriter, r *http.Request, name string) bool {
	cookie, err := r.Cookie(name)
	if err != nil {
		return false
	}
	ok := cookie.Value != "" && r.URL.Query().Get("state") == cookie.Value
	http.SetCookie(w, &http.Cookie{Name: name, Value: "", MaxAge: -1, Path: "/auth/feishu/"})
	return ok
}

func randomState(byteLen int) (string, error) {
	b := make([]byte, byteLen)
	if _, err := rand.Read(b); err != nil {
		return "", err
	}
	return base64.RawURLEncoding.EncodeToString(b), nil
}

func isAllowedTenant(tenantKey string) bool {
	allowed := os.Getenv("FEISHU_ALLOWED_TENANT_KEYS")
	if allowed == "" {
		return true
	}
	for _, k := range strings.Split(allowed, ",") {
		if strings.TrimSpace(k) == tenantKey {
			return true
		}
	}
	return false
}

